        "group_faq_item_QqRPdT": {
          "type": "_group-faq-item",
          "name": "t:sections.faqs-page.blocks.question.questions",
          "settings": {},
          "blocks": {
            "buy_0": {
              "type": "_faq-item",
              "settings": {
                "faq_title": "¿Cuánto tarda en llegar mi pedido?",
                "faq_content": "Despachamos tu pedido en un máximo de <strong>5 días hábiles</strong> después de confirmado el pago. El tiempo de entrega depende de la transportadora y de tu ciudad. Despachamos de lunes a viernes; no hay despachos sábados, domingos ni festivos."
              }
            },
            "buy_1": {
              "type": "_faq-item",
              "settings": {
                "faq_title": "¿El envío es gratis?",
                "faq_content": "Sí, en pedidos superiores a <strong>$1.000.000</strong> con destino a capitales de departamento (promoción \"Envío gratis, aplican T&C\"). Para otras ciudades te informamos el costo del envío después del pago. Consulta nuestra <a href=\"/policies/shipping-policy\" target=\"_blank\" title=\"Política de envíos\">política de envíos</a>."
              }
            },
            "buy_2": {
              "type": "_faq-item",
              "settings": {
                "faq_title": "¿Cómo puedo pagar?",
                "faq_content": "Aceptamos tarjetas de crédito y débito, PSE y pago a cuotas con <strong>Addi</strong>. Todos los pagos se procesan de forma segura."
              }
            },
            "buy_3": {
              "type": "_faq-item",
              "settings": {
                "faq_title": "¿Puedo pagar a cuotas?",
                "faq_content": "Sí. Con <strong>Addi</strong> puedes pagar hasta en <strong>24 cuotas</strong>; solo necesitas tu cédula y WhatsApp. Sujeto a criterios de elegibilidad de Addi."
              }
            },
            "buy_4": {
              "type": "_faq-item",
              "settings": {
                "faq_title": "¿Qué hago si mi pedido llega dañado?",
                "faq_content": "Revisa el empaque y el producto al recibirlo. Si presenta daños, repórtalo ante la transportadora en el momento de la entrega y envíanos fotos el mismo día por WhatsApp o correo para gestionar la reclamación ante el seguro del transporte."
              }
            }
          },
