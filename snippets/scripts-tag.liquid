{%- liquid
  assign t = template | split: '.' | first
-%}
{%- comment -%}
  cart-components.js va como script propio, delante de theme.js y con la misma
  semantica de modulo. Antes lo importaba theme.js con una ruta relativa, que se
  resuelve SIN el ?v= de asset_url: el CDN lo sirve con max-age de un ano, asi que
  un cambio en ese archivo no llegaba a quien ya lo tenia en cache. Ademas solo
  empezaba a bajar cuando theme.js ya habia llegado (una ida y vuelta de mas).
{%- endcomment -%}
{%- if defer_by_age_gate -%}
  <script>
    window.diyvapeDeferredAssets.push(
      { type: 'script', src: {{ 'tingle.js' | asset_url | json }} },
      { type: 'script', src: {{ 'cart-components.js' | asset_url | json }}, module: true },
      { type: 'script', src: {{ 'theme.js' | asset_url | json }}, module: true }
      {%- case t -%}
        {%- when 'collection' -%}
          ,{ type: 'script', src: {{ 'collection.js' | asset_url | json }} }
        {%- when 'product' -%}
          ,{ type: 'script', src: {{ 'main-product.js' | asset_url | json }} }
          {%- liquid
            assign has_360_image = false
            for media in product.media
              if media.media_type == 'image' and media.alt == 'image-360'
                assign has_360_image = true
                break
              endif
            endfor
          -%}
          {%- if has_360_image -%}
            ,{ type: 'script', src: {{ 'js-cloudimage-360-view.min.js' | asset_url | json }} }
          {%- endif -%}
        {%- when 'search' -%}
          ,{ type: 'script', src: {{ 'collection.js' | asset_url | json }} }
      {%- endcase -%}
    );
  </script>
{%- else -%}
  <script src="{{ 'tingle.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'cart-components.js' | asset_url }}" defer="defer" type="module"></script>
  <script src="{{ 'theme.js' | asset_url }}"  defer="defer" type="module"></script>
  {%- case t -%}
    {%- when 'collection' -%}
      <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
    {%- when 'product' -%}
      <script src="{{ 'main-product.js' | asset_url }}" defer="defer"></script>
      {%- liquid
        assign has_360_image = false
        for media in product.media
          if media.media_type == 'image' and media.alt == 'image-360'
            assign has_360_image = true
            break
          endif
        endfor
      -%}
      {%- if has_360_image -%}
        <script src="{{ 'js-cloudimage-360-view.min.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}
    {%- when 'search' -%}
      <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
  {%- endcase -%}
{%- endif -%}
