{%- comment -%}
  Collection description rendered at the bottom of the collection template (custom-liquid section),
  clamped to a peek height with a "keep reading" toggle so a two-paragraph SEO text doesn't push
  the product grid down. Colours come from the section's colour scheme variables so it follows the
  theme palette. Short descriptions (< 200 chars) render without the toggle.
{%- endcomment -%}
{%- assign guide_plain = collection.description | strip_html | strip -%}
{%- assign guide_len = guide_plain | size -%}
{%- if guide_len > 0 -%}
{%- assign guide_brand = settings.seo_brand_name | default: shop.name -%}
{%- assign guide_variant = 'collection-guide--standard' -%}
{%- if guide_len < 200 -%}{%- assign guide_variant = 'collection-guide--brief' -%}{%- endif -%}
<style>
  .collection-guide {
    --guide-peek: 240px;
    position: relative;
    margin: 2rem 0;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: 6px;
    color: var(--color-text);
  }
  .collection-guide__outer {
    position: relative;
    overflow: hidden;
    max-height: none;
    transition: max-height 0.42s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .collection-guide--clamped .collection-guide__outer { max-height: var(--guide-peek); }
  .collection-guide__inner { padding: 20px 28px 24px; line-height: 1.8; }

  .collection-guide__fade {
    display: none;
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 96px;
    background: linear-gradient(to bottom, transparent 0%, var(--color-background) 92%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .collection-guide--clamped .collection-guide__fade { display: block; opacity: 1; }
  .collection-guide--open .collection-guide__fade { opacity: 0; }

  .collection-guide__toggle { display: none; }
  .collection-guide--clamped .collection-guide__toggle,
  .collection-guide--open .collection-guide__toggle {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; width: 100%; background: none; border: none;
    border-top: 1px solid var(--color-border);
    padding: 16px 24px 16px 28px; cursor: pointer; text-align: left;
    font: inherit; color: inherit;
    transition: background 0.2s;
  }
  .collection-guide__toggle:hover { background: rgba(var(--color-primary-rgb), 0.05); }
  .collection-guide__toggle:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }

  .collection-guide__eyebrow {
    font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-primary);
    display: block; margin-bottom: 4px;
  }
  .collection-guide__label {
    font-size: 14px; font-weight: 600; color: var(--color-heading);
    line-height: 1.4; display: block;
  }
  .collection-guide__label-less { display: none; }
  .collection-guide--open .collection-guide__label-more { display: none; }
  .collection-guide--open .collection-guide__label-less { display: inline; }

  .collection-guide__icon {
    flex-shrink: 0; width: 26px; height: 26px;
    border: 1px solid var(--color-border); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    position: relative; transition: border-color 0.2s;
  }
  .collection-guide__toggle:hover .collection-guide__icon,
  .collection-guide--open .collection-guide__icon { border-color: var(--color-primary); }
  .collection-guide__bar {
    position: absolute; background: rgba(var(--color-heading-rgb), 0.6); border-radius: 1px;
    transition: transform 0.28s ease, opacity 0.28s ease, background 0.2s;
  }
  .collection-guide__bar--h { width: 10px; height: 1.5px; }
  .collection-guide__bar--v { width: 1.5px; height: 10px; }
  .collection-guide__toggle:hover .collection-guide__bar,
  .collection-guide--open .collection-guide__bar { background: var(--color-primary); }
  .collection-guide--open .collection-guide__bar--v { transform: rotate(90deg); opacity: 0; }

  .collection-guide__text > *:first-child { margin-top: 0; }
  .collection-guide__text > *:last-child { margin-bottom: 0; }
  .collection-guide__text p:empty, .collection-guide__text br:first-child { display: none; }
  .collection-guide__text h1, .collection-guide__text h2 { font-size: 18px; margin: 0 0 14px; line-height: 1.3; }
  .collection-guide__text h3 { font-size: 15px; margin: 22px 0 10px; line-height: 1.35; }
  .collection-guide__text h4 { font-size: 14px; margin: 18px 0 8px; line-height: 1.4; }
  .collection-guide__text p { font-size: 14px; margin: 0 0 12px; }
  .collection-guide__text a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
  .collection-guide__text ul, .collection-guide__text ol { padding-left: 18px; margin: 0 0 12px; }
  .collection-guide__text li { margin-bottom: 4px; }
  .collection-guide__text img { max-width: 100%; height: auto; }

  .collection-guide--brief .collection-guide__inner { padding: 16px 24px 18px; }
  .collection-guide--brief .collection-guide__toggle,
  .collection-guide--brief .collection-guide__fade { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .collection-guide__outer, .collection-guide__fade, .collection-guide__bar { transition: none; }
  }
</style>

<div class="collection-guide {{ guide_variant }}" data-collection-guide>
  <div class="collection-guide__outer" id="collectionGuide-{{ collection.id }}" role="region" aria-labelledby="collectionGuideToggle-{{ collection.id }}">
    <div class="collection-guide__inner">
      <div class="collection-guide__text rich__text-m0">
        {{ collection.description }}
      </div>
    </div>
    <span class="collection-guide__fade"></span>
  </div>

  <button type="button" class="collection-guide__toggle" id="collectionGuideToggle-{{ collection.id }}" aria-expanded="false" aria-controls="collectionGuide-{{ collection.id }}">
    <span>
      <span class="collection-guide__eyebrow">{{ guide_brand }} &middot; Guía de compra</span>
      <span class="collection-guide__label">
        <span class="collection-guide__label-more">Seguir leyendo sobre {{ collection.title }}</span>
        <span class="collection-guide__label-less">Mostrar menos</span>
      </span>
    </span>
    <span class="collection-guide__icon" aria-hidden="true">
      <span class="collection-guide__bar collection-guide__bar--h"></span>
      <span class="collection-guide__bar collection-guide__bar--v"></span>
    </span>
  </button>
</div>

<script>
(function () {
  function peekOf(wrap) {
    var v = getComputedStyle(wrap).getPropertyValue('--guide-peek');
    return parseInt(v, 10) || 240;
  }

  function measure() {
    var wraps = document.querySelectorAll('[data-collection-guide]');
    for (var i = 0; i < wraps.length; i++) {
      var wrap = wraps[i];
      if (wrap.classList.contains('collection-guide--brief')) continue;
      if (wrap.classList.contains('collection-guide--open')) continue;
      var box = wrap.querySelector('.collection-guide__outer');
      if (!box) continue;
      wrap.classList.remove('collection-guide--clamped');
      box.style.maxHeight = '';
      if (box.scrollHeight > peekOf(wrap) + 40) wrap.classList.add('collection-guide--clamped');
    }
  }

  function toggle(wrap) {
    var btn = wrap.querySelector('.collection-guide__toggle');
    var box = wrap.querySelector('.collection-guide__outer');
    if (!btn || !box) return;

    if (wrap.classList.contains('collection-guide--open')) {
      box.style.maxHeight = box.scrollHeight + 'px';
      requestAnimationFrame(function () {
        wrap.classList.remove('collection-guide--open');
        wrap.classList.add('collection-guide--clamped');
        btn.setAttribute('aria-expanded', 'false');
        box.style.maxHeight = peekOf(wrap) + 'px';
      });
    } else {
      box.style.maxHeight = box.scrollHeight + 'px';
      wrap.classList.add('collection-guide--open');
      btn.setAttribute('aria-expanded', 'true');
      box.addEventListener('transitionend', function () {
        if (wrap.classList.contains('collection-guide--open')) {
          wrap.classList.remove('collection-guide--clamped');
          box.style.maxHeight = '';
        }
      }, { once: true });
    }
  }

  if (!window.__collectionGuideBound) {
    window.__collectionGuideBound = true;
    document.addEventListener('click', function (e) {
      var t = e.target;
      while (t && t !== document && !(t.classList && t.classList.contains('collection-guide__toggle'))) t = t.parentNode;
      if (!t || t === document) return;
      var wrap = t.closest('[data-collection-guide]');
      if (wrap) toggle(wrap);
    });
    document.addEventListener('shopify:section:load', measure);
    document.addEventListener('shopify:section:select', measure);
    window.addEventListener('load', measure);
    window.addEventListener('resize', function () {
      clearTimeout(window.__collectionGuideT);
      window.__collectionGuideT = setTimeout(measure, 200);
    });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', measure);
  } else {
    measure();
  }
})();
</script>
{%- endif -%}
