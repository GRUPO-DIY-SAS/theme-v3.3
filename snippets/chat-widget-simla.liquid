{% comment %}
  Chat de Simla (RetailCRM) bajo demanda — mismo patrón que el chat de diyvape.co.
  El ScriptTag de simla.js queda retenido por deferred-assets-loader (bucket 'chat');
  aquí se pinta solo un botón flotante ligero y, al primer toque, se libera el script
  (window.diyvapeFlushChat) y se abre el launcher real cuando aparece.
{% endcomment %}
{%- unless template contains 'password' -%}
  <button type="button" id="hs-chat-trigger" class="hs-chat-trigger" aria-label="Abrir chat">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <span class="hs-chat-trigger__label">Chat</span>
  </button>
  <style>
    .hs-chat-trigger { position: fixed; right: 20px; bottom: 24px; z-index: 99998; display: inline-flex; align-items: center; gap: 8px; padding: 0 18px 0 14px; height: 52px; border: 0; border-radius: 999px; background: var(--btn-primary-bg-color, #14213d); color: var(--btn-primary-color, #fff); font-family: inherit; font-size: 15px; font-weight: 600; line-height: 1; cursor: pointer; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18); -webkit-tap-highlight-color: transparent; }
    .hs-chat-trigger:focus-visible { outline: 2px solid var(--btn-primary-color, #fff); outline-offset: 2px; }
    .hs-chat-trigger[hidden] { display: none !important; }
    .hs-chat-trigger.is-loading { opacity: 0.7; pointer-events: none; }
    @media (max-width: 767.98px) { .hs-chat-trigger { right: 16px; bottom: 16px; padding: 0; width: 52px; justify-content: center; } .hs-chat-trigger__label { display: none; } }
  </style>
  <script>
    (function () {
      var TRIGGER_ID = 'hs-chat-trigger';
      var loaded = false;
      var preconnected = false;
      function trigger() { return document.getElementById(TRIGGER_ID); }
      function preconnect() {
        if (preconnected) return; preconnected = true;
        ['https://shopify.retailcrm.tech', 'https://c.retailcrm.tech'].forEach(function (h) {
          var l = document.createElement('link'); l.rel = 'preconnect'; l.href = h; l.crossOrigin = ''; document.head.appendChild(l);
        });
      }
      function isOurs(el) { return !el || el.id === TRIGGER_ID || (el.closest && el.closest('#' + TRIGGER_ID)); }
      // Simla monta su app en #retailcrm-consultant-app; en cuanto existe, nuestro botón sobra.
      function findLauncher() {
        var app = document.getElementById('retailcrm-consultant-app');
        if (app) {
          return app.querySelector('button, [class*="consultant-button"], [class*="bubble"], [role="button"]') || app;
        }
        return findLauncherGeneric();
      }
      function findLauncherGeneric() {
        var vw = window.innerWidth, vh = window.innerHeight;
        var nodes = document.querySelectorAll('body > *, [class*="simla"], [id*="simla"], [class*="retailcrm"], [id*="retailcrm"], [class*="chat"], iframe');
        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];
          if (isOurs(el) || el.tagName === 'SCRIPT' || el.tagName === 'STYLE' || el.tagName === 'LINK') continue;
          var cs; try { cs = getComputedStyle(el); } catch (e) { continue; }
          if (cs.position !== 'fixed' || cs.display === 'none' || cs.visibility === 'hidden') continue;
          var r = el.getBoundingClientRect();
          if (r.width < 36 || r.height < 36 || r.width > 120 || r.height > 120) continue;
          if (vh - r.bottom > 200 || vw - r.right > 160) continue;
          return el;
        }
        return null;
      }
      function openWhenReady(tries) {
        var el = findLauncher();
        if (el) {
          var btn = trigger(); if (btn) btn.hidden = true;
          try { el.click(); } catch (e) {}
          try { var innerBtn = el.querySelector && el.querySelector('button, [role="button"]'); if (innerBtn) innerBtn.click(); } catch (e) {}
          return;
        }
        if (tries > 0) setTimeout(function () { openWhenReady(tries - 1); }, 400);
        else { var btn2 = trigger(); if (btn2) { btn2.classList.remove('is-loading'); } }
      }
      function load() {
        if (loaded) return; loaded = true;
        preconnect();
        var btn = trigger(); if (btn) btn.classList.add('is-loading');
        if (window.diyvapeFlushChat) window.diyvapeFlushChat();
        openWhenReady(30);
      }
      // No competir con el aviso de cookies: el botón aparece cuando el usuario responde (theme.js elimina <cookie-bar>).
      function cookiePending() { var c = document.getElementById('cookie'); return c && !c.classList.contains('hidden'); }
      function watchCookie() {
        var btn = trigger(); if (!btn) return;
        if (cookiePending()) { btn.hidden = true; setTimeout(watchCookie, 800); }
        else if (!loaded) { btn.hidden = false; }
      }
      watchCookie();
      var btn = trigger();
      if (btn) {
        btn.addEventListener('mouseenter', preconnect, { once: true, passive: true });
        btn.addEventListener('focus', preconnect, { once: true, passive: true });
        btn.addEventListener('click', load);
      }
    })();
  </script>
{%- endunless -%}
