{%- comment -%}
  Rich text band for the collection-tabs-spotlight super-section.
  Rendered full-width above (position: top) or below (position: bottom) the tabs/products.
  Accepts: block.
{%- endcomment -%}
{%- assign rt = block.settings -%}
{%- if rt.heading != blank or rt.content != blank -%}
  <div
    class="featured-tabs-spotlight__richtext featured-tabs-spotlight__richtext--{{ rt.position | default: 'top' }} text-{{ rt.text_alignment | default: 'center' }}"
    {% if rt.max_width > 0 %}style="--spotlight-rt-max: {{ rt.max_width }}px;"{% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if rt.heading != blank -%}
      <h2 class="featured-tabs-spotlight__richtext-heading h3 mt-0 mb-10"{% if rt.heading_size > 0 %} style="font-size: {{ rt.heading_size }}px; line-height: 1.15;"{% endif %}>{{ rt.heading }}</h2>
    {%- endif -%}
    {%- if rt.content != blank -%}
      <div class="featured-tabs-spotlight__richtext-body rich__text rich__text-m0"{% if rt.text_size > 0 %} style="font-size: {{ rt.text_size }}px;"{% endif %}>{{ rt.content }}</div>
    {%- endif -%}
  </div>
{%- endif -%}
