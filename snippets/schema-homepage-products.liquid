{% doc %}
  Genera schemas JSON-LD de tipo ItemList para las 5 secciones de productos
  del homepage. Incluye AggregateRating por producto cuando existen reseñas
  sincronizadas por Judge.me en los metafields reviews.rating y reviews.rating_count.

  Solo se renderiza en el template index (homepage).

  @example
  {% render 'schema-homepage-products' %}
{% enddoc %}

{%- if template == 'index' -%}
  {%- assign hp_sections = 'fitness,movilidad-electrica,bicicletas,max-tools,sale' | split: ',' -%}
  {%- assign hp_names    = 'Entrenar en casa,Movilidad eléctrica Roadmaster,Bicicletas,Herramientas Max Tools,Los más vendidos en Homesale' | split: ',' -%}
  {%- assign hp_limits   = '8,8,8,8,12' | split: ',' -%}

  {%- for handle in hp_sections -%}
    {%- assign collection   = collections[handle] -%}
    {%- assign section_name = hp_names[forloop.index0] -%}
    {%- assign section_limit = hp_limits[forloop.index0] | plus: 0 -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      {%- assign position   = 0 -%}
      {%- assign items_json = '' -%}

      {%- for product in collection.products limit: section_limit -%}
        {%- if product.available and product.featured_image != blank and product.price > 0 -%}
          {%- assign position = position | plus: 1 -%}

          {%- comment -%} Judge.me rating metafields {%- endcomment -%}
          {%- assign jdgm_rating = product.metafields.reviews.rating -%}
          {%- assign jdgm_count  = product.metafields.reviews.rating_count -%}
          {%- assign count_value  = jdgm_count.value | plus: 0 -%}
          {%- assign rating_value = jdgm_rating.value.rating | round: 2 -%}

          {%- comment -%}
            JSON compacto y sin description/sku/seller: los 5 ItemList de la home pesaban 58 KB de HTML
            (Google no usa ItemList de la home para rich results de producto; name/url/image/offers/rating bastan).
          {%- endcomment -%}
          {%- capture item_json -%}
            {"@type":"ListItem","position":{{ position }},"item":{"@type":"Product","name":{{ product.title | json }},"url":"{{ shop.url }}{{ product.url }}","image":"{{ product.featured_image | image_url: width: 800 }}","brand":{"@type":"Brand","name":{{ product.vendor | json }}},"offers":{"@type":"Offer","url":"{{ shop.url }}{{ product.url }}","priceCurrency":"COP","price":"{{ product.price | money_without_currency | remove: '.' | remove: ',' }}","availability":"https://schema.org/InStock"}{% if jdgm_rating != blank and count_value > 0 %},"aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ rating_value }}","reviewCount":{{ count_value }},"bestRating":"5","worstRating":"1"}{% endif %}}}
          {%- endcapture -%}

          {%- if items_json == '' -%}
            {%- assign items_json = item_json -%}
          {%- else -%}
            {%- assign items_json = items_json | append: ',' | append: item_json -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if position > 0 -%}
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","name":{{ section_name | json }},"numberOfItems":{{ position }},"itemListElement":[{{ items_json }}]}</script>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}