{%- assign diy_plain = collection.description | strip_html | strip -%}
{%- assign diy_len = diy_plain | size -%}
{%- if diy_len > 0 -%}
{%- assign diy_variant = 'diy-standard' -%}
{%- if diy_len < 200 -%}{%- assign diy_variant = 'diy-brief' -%}{%- endif -%}
<style>
  .diy-collapsible-wrap {
    --lab-red:  #C8102E;
    --carbon:   #0A0A0A;
    --bone:     #F5F2EC;
    --steel:    #B8B4AC;
    --diy-peek: 260px;
    background: var(--carbon);
    border-radius: 2px;
    padding: 0;
    position: relative;
    margin: 2rem 0;
    border-left: 3px solid var(--lab-red);
  }

  .diy-content-outer {
    position: relative;
    overflow: hidden;
    max-height: none;
    opacity: 1;
    transition: max-height 0.42s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .diy-collapsible-wrap.diy-clamped .diy-content-outer { max-height: var(--diy-peek); }
  .diy-content-inner { padding: 20px 28px 24px; line-height: 1.8; }

  .diy-fade {
    display: none;
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 96px;
    background: linear-gradient(to bottom, rgba(10, 10, 10, 0) 0%, #0A0A0A 92%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .diy-collapsible-wrap.diy-clamped .diy-fade { display: block; opacity: 1; }
  .diy-collapsible-wrap.diy-open   .diy-fade { opacity: 0; }

  .diy-toggle-btn { display: none; }
  .diy-collapsible-wrap.diy-clamped .diy-toggle-btn,
  .diy-collapsible-wrap.diy-open    .diy-toggle-btn {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; width: 100%; background: none; border: none;
    border-top: 1px solid #1f1f1f;
    padding: 18px 24px 18px 28px; cursor: pointer; text-align: left;
    font: inherit; color: inherit;
    transition: background 0.2s;
  }
  .diy-toggle-btn:hover { background: rgba(200, 16, 46, 0.06); }
  .diy-toggle-btn:focus-visible { outline: 2px solid var(--lab-red); outline-offset: -2px; }

  .diy-eyebrow {
    font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--lab-red);
    display: block; margin-bottom: 6px;
  }
  .diy-title-text {
    font-size: 14px; font-weight: 600; color: var(--bone);
    line-height: 1.4; transition: color 0.2s; display: block;
  }
  .diy-toggle-btn:hover .diy-title-text { color: #FFFFFF; }
  .diy-label-less { display: none; }
  .diy-collapsible-wrap.diy-open .diy-label-more { display: none; }
  .diy-collapsible-wrap.diy-open .diy-label-less { display: inline; }

  .diy-icon {
    flex-shrink: 0; width: 26px; height: 26px;
    border: 1px solid #2e2e2e; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    position: relative; transition: border-color 0.2s;
  }
  .diy-toggle-btn:hover .diy-icon,
  .diy-collapsible-wrap.diy-open .diy-icon { border-color: var(--lab-red); }
  .diy-icon-bar {
    position: absolute; background: #555; border-radius: 1px;
    transition: transform 0.28s ease, opacity 0.28s ease, background 0.2s;
  }
  .diy-icon-bar.h { width: 10px; height: 1.5px; }
  .diy-icon-bar.v { width: 1.5px; height: 10px; }
  .diy-toggle-btn:hover .diy-icon-bar,
  .diy-collapsible-wrap.diy-open .diy-icon-bar { background: var(--lab-red); }
  .diy-collapsible-wrap.diy-open .diy-icon-bar.v { transform: rotate(90deg); opacity: 0; }

  .diy-divider {
    display: block; height: 1px; margin: 0 0 16px; opacity: 0.5;
    background: linear-gradient(to right, #C8102E 0%, #2a0008 60%, transparent 100%);
  }

  .diy-rich-text { color: var(--steel); }
  .diy-rich-text > *:first-child { margin-top: 0 !important; }
  .diy-rich-text > *:last-child  { margin-bottom: 0 !important; }
  .diy-rich-text p:empty, .diy-rich-text br:first-child { display: none; }
  .diy-rich-text h1, .diy-rich-text h2 {
    font-size: 18px !important; font-weight: 700 !important; color: var(--bone) !important;
    margin: 0 0 14px !important; line-height: 1.3 !important;
  }
  .diy-rich-text h3 {
    font-size: 15px !important; font-weight: 700 !important; color: var(--bone) !important;
    margin: 22px 0 10px !important; line-height: 1.35 !important;
  }
  .diy-rich-text h4 {
    font-size: 14px !important; font-weight: 600 !important; color: var(--bone) !important;
    margin: 18px 0 8px !important; line-height: 1.4 !important;
  }
  .diy-rich-text p {
    color: var(--steel) !important; font-size: 14px !important; margin: 0 0 12px !important;
  }
  .diy-rich-text a {
    color: var(--lab-red) !important;
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
  }
  .diy-rich-text a:hover { color: #ff2040 !important; }
  .diy-rich-text strong, .diy-rich-text b { color: var(--bone) !important; font-weight: 600 !important; }
  .diy-rich-text ul, .diy-rich-text ol {
    color: var(--steel) !important; padding-left: 18px !important; margin: 0 0 12px !important;
  }
  .diy-rich-text li { color: var(--steel) !important; margin-bottom: 4px !important; }
  .diy-rich-text img { max-width: 100%; height: auto; }

  .diy-collapsible-wrap.diy-brief .diy-content-inner { padding: 16px 24px 18px; }
  .diy-collapsible-wrap.diy-brief .diy-divider { display: none; }
  .diy-collapsible-wrap.diy-brief .diy-toggle-btn { display: none !important; }
  .diy-collapsible-wrap.diy-brief .diy-fade { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .diy-content-outer, .diy-fade, .diy-icon-bar { transition: none; }
  }
</style>

<div class="diy-collapsible-wrap {{ diy_variant }}" data-diy-collapsible>
  <div class="diy-content-outer" id="diyContent-{{ collection.id }}" role="region" aria-labelledby="diyToggle-{{ collection.id }}">
    <div class="diy-content-inner">
      <span class="diy-divider"></span>
      <div class="diy-rich-text">
        {{ collection.description }}
      </div>
    </div>
    <span class="diy-fade"></span>
  </div>

  <button type="button" class="diy-toggle-btn" id="diyToggle-{{ collection.id }}" aria-expanded="false" aria-controls="diyContent-{{ collection.id }}">
    <span>
      <span class="diy-eyebrow">DIY Vape Shop · Guía de colección</span>
      <span class="diy-title-text">
        <span class="diy-label-more">Seguir leyendo sobre <span style="color:#C8102E;">{{ collection.title }}</span> y todo lo relacionado con el mundo del vapeo</span>
        <span class="diy-label-less">Mostrar menos</span>
      </span>
    </span>
    <span class="diy-icon">
      <span class="diy-icon-bar h"></span>
      <span class="diy-icon-bar v"></span>
    </span>
  </button>
</div>

<script>
(function () {
  function peekOf(wrap) {
    var v = getComputedStyle(wrap).getPropertyValue('--diy-peek');
    return parseInt(v, 10) || 260;
  }

  function measure() {
    var wraps = document.querySelectorAll('[data-diy-collapsible]');
    for (var i = 0; i < wraps.length; i++) {
      var wrap = wraps[i];
      if (wrap.classList.contains('diy-brief')) continue;
      if (wrap.classList.contains('diy-open')) continue;
      var box = wrap.querySelector('.diy-content-outer');
      if (!box) continue;
      wrap.classList.remove('diy-clamped');
      box.style.maxHeight = '';
      if (box.scrollHeight > peekOf(wrap) + 40) wrap.classList.add('diy-clamped');
    }
  }

  function toggle(wrap) {
    var btn = wrap.querySelector('.diy-toggle-btn');
    var box = wrap.querySelector('.diy-content-outer');
    if (!btn || !box) return;

    if (wrap.classList.contains('diy-open')) {
      box.style.maxHeight = box.scrollHeight + 'px';
      requestAnimationFrame(function () {
        wrap.classList.remove('diy-open');
        wrap.classList.add('diy-clamped');
        btn.setAttribute('aria-expanded', 'false');
        box.style.maxHeight = peekOf(wrap) + 'px';
      });
    } else {
      box.style.maxHeight = box.scrollHeight + 'px';
      wrap.classList.add('diy-open');
      btn.setAttribute('aria-expanded', 'true');
      box.addEventListener('transitionend', function () {
        if (wrap.classList.contains('diy-open')) {
          wrap.classList.remove('diy-clamped');
          box.style.maxHeight = '';
        }
      }, { once: true });
    }
  }

  if (!window.__diyCollapsibleBound) {
    window.__diyCollapsibleBound = true;
    document.addEventListener('click', function (e) {
      var t = e.target;
      while (t && t !== document && !(t.classList && t.classList.contains('diy-toggle-btn'))) t = t.parentNode;
      if (!t || t === document) return;
      var wrap = t.parentNode;
      while (wrap && wrap !== document && !(wrap.hasAttribute && wrap.hasAttribute('data-diy-collapsible'))) wrap = wrap.parentNode;
      if (wrap && wrap !== document) toggle(wrap);
    });
    document.addEventListener('shopify:section:load', measure);
    document.addEventListener('shopify:section:select', measure);
    window.addEventListener('load', measure);
    window.addEventListener('resize', function () {
      clearTimeout(window.__diyCollapsibleT);
      window.__diyCollapsibleT = setTimeout(measure, 200);
    });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', measure);
  } else {
    measure();
  }
})();
</script>
{%- endif -%}