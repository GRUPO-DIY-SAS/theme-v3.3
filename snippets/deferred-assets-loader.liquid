<script>
  window.diyvapeDeferredAssets = window.diyvapeDeferredAssets || [];
  (function () {
    if (window.diyvapeDeferredLoaderReady) return;

    window.diyvapeDeferredLoaderReady = true;

    var assets = window.diyvapeDeferredAssets;
    var pageType = {{ request.page_type | json }};
    var requested = false;
    var scriptChain = Promise.resolve();
    var loaded = {};
    var loadedPromises = {};
    var visualStylePromises = [];
    var visualReady = false;
    var visualReadyTimer = null;
    var originalPush = assets.push.bind(assets);
    var originalAppendChild = Node.prototype.appendChild;
    var originalInsertBefore = Node.prototype.insertBefore;
    var blockedDynamicAssets = [];
    var releasingDynamicAssets = false;
    var postGateDynamicAssetsScheduled = false;
    var releasedDynamicGroups = {};
    var initiallyAgeVerified = isAgeVerified();

    function getNodeUrl(node) {
      if (!node || node.nodeType !== 1) return '';
      var tagName = node.tagName;
      if (tagName === 'SCRIPT') return node.src || '';
      if (tagName === 'LINK') return node.href || '';
      return '';
    }

    function getDeferredDynamicGroup(url) {
      var value = String(url || '').toLowerCase();
      if (!value) return '';

      if (
        value.indexOf('rapi-487') !== -1 ||
        value.indexOf('rappi-front.') !== -1 ||
        value.indexOf('rapi-front.') !== -1
      ) {
        return 'rapi';
      }

      if (
        value.indexOf('mercadopago-pf-app') !== -1 ||
        value.indexOf('generate-meli-session-id') !== -1 ||
        value.indexOf('mercadopago.com') !== -1 ||
        value.indexOf('melidata') !== -1
      ) {
        return 'commerce';
      }

      if (
        value.indexOf('judgeme-505') !== -1 ||
        value.indexOf('judge.me') !== -1 ||
        value.indexOf('cdnwidget.judge.me') !== -1
      ) {
        return 'reviews';
      }

      if (
        value.indexOf('googletagmanager.com/gtag/js') !== -1 ||
        value.indexOf('/wpm/') !== -1 ||
        value.indexOf('web-pixels-manager') !== -1 ||
        value.indexOf('splmn-shopify-prod') !== -1
      ) {
        return 'analytics';
      }

      return '';
    }

    function shouldReleaseDynamicAsset(entry, group) {
      if (!entry) return false;
      if (group && entry.group !== group) return false;
      /* Rapi y Judge.me sólo tienen sentido en PDP. En cualquier otra página
         los seguimos bloqueando incluso después del age gate — el merchant
         confirmó que Judge.me solo se usa en product page y Rapi también. */
      if (entry.group === 'rapi' && pageType !== 'product') return false;
      if (entry.group === 'reviews' && pageType !== 'product') return false;
      return true;
    }

    function blockDynamicAsset(parent, node, referenceNode) {
      var url = getNodeUrl(node);
      var group = getDeferredDynamicGroup(url);
      if (!group) return false;
      if (group === 'rapi' && pageType !== 'product') return true;
      if (group === 'reviews' && pageType !== 'product') return true;
      if (releasingDynamicAssets || releasedDynamicGroups[group] || initiallyAgeVerified) return false;
      blockedDynamicAssets.push({
        parent: parent,
        node: node,
        referenceNode: referenceNode,
        url: url,
        group: group
      });
      return true;
    }

    function appendDynamicAsset(entry) {
      var parent = entry.parent || document.head || document.documentElement;
      if (entry.referenceNode && entry.referenceNode.parentNode === parent) {
        originalInsertBefore.call(parent, entry.node, entry.referenceNode);
      } else {
        originalAppendChild.call(parent, entry.node);
      }
    }

    function releaseDynamicAssets(group) {
      if (group) {
        releasedDynamicGroups[group] = true;
      } else {
        releasedDynamicGroups.rapi = true;
        releasedDynamicGroups.commerce = true;
        releasedDynamicGroups.reviews = true;
        releasedDynamicGroups.analytics = true;
      }
      if (!blockedDynamicAssets.length) return;
      releasingDynamicAssets = true;
      var remaining = [];
      blockedDynamicAssets.splice(0).forEach(function (entry) {
        if (group && entry.group !== group) {
          remaining.push(entry);
          return;
        }
        if (shouldReleaseDynamicAsset(entry, group)) appendDynamicAsset(entry);
      });
      blockedDynamicAssets = remaining;
      releasingDynamicAssets = false;
    }

    function runWhenIdle(callback, timeout) {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(callback, { timeout: timeout || 3000 });
      } else {
        window.setTimeout(callback, timeout || 1);
      }
    }

    function closestTarget(event, selector) {
      var target = event && event.target;
      if (target && target.nodeType !== 1) target = target.parentElement;
      return target && target.closest ? target.closest(selector) : null;
    }

    function releaseCommerceAssets() {
      releaseDynamicAssets('commerce');
    }

    function scheduleCommerceAssets() {
      if (releasedDynamicGroups.commerce) return;
      var released = false;
      var selector = [
        'a[href*="/cart"]',
        'a[href*="/checkout"]',
        'button[name="add"]',
        'button[name="checkout"]',
        '[data-add-to-cart]',
        '[data-cart]',
        '.shopify-payment-button',
        '.product-form__submit',
        'cart-drawer',
        'cart-items'
      ].join(',');

      var release = function () {
        if (released) return;
        released = true;
        document.removeEventListener('click', onClick, true);
        document.removeEventListener('submit', onSubmit, true);
        releaseCommerceAssets();
      };

      var onClick = function (event) {
        if (closestTarget(event, selector)) release();
      };

      var onSubmit = function (event) {
        var target = event && event.target;
        var action = target && target.getAttribute ? target.getAttribute('action') || '' : '';
        if (action.indexOf('/cart') !== -1 || closestTarget(event, 'form[action*="/cart"]')) release();
      };

      document.addEventListener('click', onClick, true);
      document.addEventListener('submit', onSubmit, true);
      runWhenIdle(release, 10000);
    }

    function scheduleReviewAssets() {
      if (releasedDynamicGroups.reviews) return;
      var release = function () {
        releaseDynamicAssets('reviews');
      };
      var reviewRoot = document.querySelector('#judgeme_product_reviews, .jdgm-widget, [class*="jdgm-"]');
      if (reviewRoot && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting || entry.intersectionRatio > 0) {
              observer.disconnect();
              release();
            }
          });
        }, { rootMargin: '500px 0px' });
        observer.observe(reviewRoot);
      } else {
        runWhenIdle(release, 6000);
      }
    }

    function scheduleAnalyticsAssets() {
      runWhenIdle(function () {
        releaseDynamicAssets('analytics');
      }, 2000);
    }

    function releasePostGateDynamicAssets() {
      if (postGateDynamicAssetsScheduled) return;
      postGateDynamicAssetsScheduled = true;
      releaseDynamicAssets('rapi');
      scheduleCommerceAssets();
      scheduleReviewAssets();
      scheduleAnalyticsAssets();
    }

    function parseVerified(raw) {
      if (!raw) return false;
      try {
        var parsed = JSON.parse(decodeURIComponent(raw));
        return Boolean(parsed && parsed.verified && parsed.dob && parsed.id);
      } catch (error) {
        try {
          var fallback = JSON.parse(raw);
          return Boolean(fallback && fallback.verified && fallback.dob && fallback.id);
        } catch (innerError) {
          return false;
        }
      }
    }

    function getCookie(name) {
      var prefix = name + '=';
      var parts = document.cookie ? document.cookie.split(';') : [];
      for (var i = 0; i < parts.length; i += 1) {
        var value = parts[i].trim();
        if (value.indexOf(prefix) === 0) return value.slice(prefix.length);
      }
      return '';
    }

    function isAgeVerified() {
      if (document.documentElement.classList.contains('age-gate-verified')) return true;
      if (parseVerified(getCookie('age_verified_diyvape'))) return true;
      try {
        return parseVerified(localStorage.getItem('age_verified_diyvape'));
      } catch (error) {
        return false;
      }
    }

    /* Interceptamos appendChild/insertBefore en estos casos:
       1) Usuario NO verificado (cualquier página) — para bloquear todo hasta age gate.
       2) Página != product (incluso para verified) — para bloquear reviews y rapi en
          collection/home/search donde no aportan valor pero sí pesan.
       Skip total para verified-en-PDP: preserva el win de v2 (cero overhead en el
       caso de mayor tráfico, los usuarios recurrentes viendo producto). */
    if (!initiallyAgeVerified || pageType !== 'product') {
      Node.prototype.appendChild = function (node) {
        if (blockDynamicAsset(this, node, null)) return node;
        return originalAppendChild.call(this, node);
      };

      Node.prototype.insertBefore = function (node, referenceNode) {
        if (blockDynamicAsset(this, node, referenceNode)) return node;
        return originalInsertBefore.call(this, node, referenceNode);
      };
    }

    function markVisualReady() {
      if (visualReady) return;
      visualReady = true;
      document.documentElement.classList.add('diyvape-deferred-visual-ready');
      window.dispatchEvent(new CustomEvent('diyvape:deferred-visual-ready'));
    }

    function waitForVisualStyles() {
      if (visualReady) return;
      if (!visualStylePromises.length) {
        markVisualReady();
        return;
      }

      Promise.all(visualStylePromises.slice()).then(markVisualReady);

      if (!visualReadyTimer) {
        visualReadyTimer = window.setTimeout(markVisualReady, 3000);
      }
    }

    function isVisualStyle(asset) {
      return asset && asset.type === 'style' && asset.visual !== false;
    }

    function loadStyle(asset) {
      if (!asset || !asset.href) return Promise.resolve();
      if (loaded[asset.href]) return loadedPromises[asset.href] || Promise.resolve();
      loaded[asset.href] = true;

      loadedPromises[asset.href] = new Promise(function (resolve) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = asset.href;
        link.media = asset.media || 'all';
        link.dataset.diyvapeDeferred = 'true';
        link.onload = resolve;
        link.onerror = resolve;
        document.head.appendChild(link);
      });

      return loadedPromises[asset.href];
    }

    function loadScript(asset) {
      if (!asset || !asset.src) return Promise.resolve();
      if (loaded[asset.src]) return loadedPromises[asset.src] || Promise.resolve();
      loaded[asset.src] = true;

      loadedPromises[asset.src] = new Promise(function (resolve) {
        var script = document.createElement('script');
        script.src = asset.src;
        script.async = false;
        script.defer = true;
        if (asset.module) script.type = 'module';
        if (asset.id) script.id = asset.id;
        script.dataset.diyvapeDeferred = 'true';
        script.onload = resolve;
        script.onerror = resolve;
        document.head.appendChild(script);
      });

      return loadedPromises[asset.src];
    }

    // Se inserta en el acto para que las descargas vayan en paralelo: con async=false
    // un script insertado por JS igual se ejecuta en orden de insercion. Antes cada uno
    // esperaba el onload del anterior para empezar a bajar, y theme.js (carrito,
    // buscador y menu) llegaba ultimo: la cadena costaba 5 s en movil 4G.
    // Los scripts consultan el DOM al ejecutarse, asi que no se insertan antes de
    // DOMContentLoaded. Esa espera va DENTRO de la cadena: aplazarla fuera dejaba la
    // cadena vacia y disparaba diyvape:deferred-assets-loaded antes que theme.js.
    var domParsed = document.readyState === 'loading'
      ? new Promise(function (resolve) {
          document.addEventListener('DOMContentLoaded', resolve, { once: true });
        })
      : Promise.resolve();

    function queueScript(asset) {
      var ready = domParsed.then(function () {
        return loadScript(asset);
      });
      scriptChain = scriptChain.then(function () {
        return ready;
      });
      return scriptChain;
    }

    function loadAsset(asset) {
      if (!asset) return;
      if (asset.type === 'style') {
        return loadStyle(asset);
      }
      if (asset.type === 'script') {
        return queueScript(asset);
      }
      return Promise.resolve();
    }

    function loadDeferredAssets() {
      if (requested) return scriptChain;
      requested = true;
      document.documentElement.classList.add('diyvape-deferred-assets-requested');

      assets.slice().forEach(function (asset) {
        var assetPromise = loadAsset(asset);
        if (isVisualStyle(asset)) visualStylePromises.push(assetPromise || Promise.resolve());
      });

      waitForVisualStyles();

      // theme.js se encola al final del <body> (scripts-tag). Si la carga arranca con el
      // HTML aun parseando, la cadena de este momento todavia no lo incluye; se toma la
      // cadena completa ya en DOMContentLoaded, cuando todas las colas inline corrieron.
      domParsed.then(function () {
        return scriptChain;
      }).then(function () {
        document.documentElement.classList.add('diyvape-deferred-assets-loaded');
        window.dispatchEvent(new CustomEvent('diyvape:deferred-assets-loaded'));
      });

      return scriptChain;
    }

    assets.push = function () {
      var incoming = Array.prototype.slice.call(arguments);
      var result = originalPush.apply(assets, incoming);
      if (requested) {
        incoming.forEach(function (asset) {
          var assetPromise = loadAsset(asset);
          if (!visualReady && isVisualStyle(asset)) {
            visualStylePromises.push(assetPromise || Promise.resolve());
            waitForVisualStyles();
          }
        });
      }
      return result;
    };

    // Carrito, buscador y menu los enlaza theme.js, que llega al final de la cola. Un
    // toque antes de eso se perdia en el buscador y en el carrito navegaba a /cart.
    //
    // Carrito y menu son solo clases sobre paneles que ya vienen en el HTML, asi que
    // se abren aqui mismo con el estado que pondria theme.js: retener el toque hasta
    // el final de la cola costaba 0,9 s en VH y 1,8 s en DIY (4G, movil de gama media).
    // El buscador depende de theme.js (busqueda predictiva, variantes de cabecera) y
    // si se retiene: la carga arranca en ese instante y el toque se repite al llegar.
    //
    // Con el gate de edad activo NO se retiene nada ni se fuerza la carga: los assets
    // siguen bloqueados hasta verificar y el enlace del carrito conserva su navegacion
    // nativa a /cart, que es lo unico que funciona en ese estado.
    var drawerTriggers = '#cart-icon-bubble, .top-search-toggle, .nav-toggle';
    var rootEl = document.documentElement;
    var scriptsReady = false;
    var replaying = false;
    var earlyCartOpen = false;
    var pendingTrigger = null;
    var pendingTimer = null;

    function gateSuppresses(panel) {
      return rootEl.classList.contains('diyvape-suppress-' + panel.toLowerCase()) ||
        (window['diyvapeSuppress' + panel + 'Until'] || 0) > Date.now();
    }

    // El gate suprime carrito y buscador ~0,4 s mientras sincroniza el carrito en cada
    // carga. Un clic real sobre el icono no es la apertura involuntaria que eso evita.
    function releaseGateSyncHold() {
      var gate = document.querySelector('age-verification-gate');
      if (gate && typeof gate.releaseSyncSuppression === 'function') gate.releaseSyncSuppression();
    }

    // html.open-drawer quita la barra de scroll y theme.js compensa su ancho con un
    // padding. El ancho se lee ANTES de tocar clases: leerlo despues obligaba a
    // recalcular estilos y layout de toda la pagina dentro del propio clic (~45 ms
    // en un movil de gama media).
    function scrollbarGap() {
      return window.innerWidth - rootEl.clientWidth;
    }

    function lockScroll(lock, gap) {
      if (lock) {
        rootEl.classList.add('open-drawer');
        if (gap > 0) document.body.style.setProperty('padding-right', gap + 'px');
      } else {
        rootEl.classList.remove('open-drawer');
        document.body.style.removeProperty('padding-right');
      }
    }

    function setNav(trigger, open) {
      var gap = open ? scrollbarGap() : 0;
      rootEl.classList.toggle('nav-open', open);
      if (!document.querySelector('.navigation.horizontal')) rootEl.classList.toggle('nav-verticalmenu', open);
      if (open) {
        trigger.classList.add('open');
      } else {
        document.querySelectorAll('.nav-toggle.open').forEach(function (toggle) {
          toggle.classList.remove('open');
        });
      }
      lockScroll(open, gap);
    }

    function cartParts() {
      var cart = document.getElementById('minicart_wrapper');
      var panel = cart ? cart.querySelector('.minicart__wrapper.bls__drawer') : null;
      return panel ? { cart: cart, panel: panel } : null;
    }

    function setCart(parts, open) {
      var gap = open ? scrollbarGap() : 0;
      earlyCartOpen = open;
      parts.cart.classList.toggle('open', open);
      parts.panel.classList.toggle('open', open);
      rootEl.classList.toggle('open-minicart', open);
      lockScroll(open, gap);
    }

    // Abrir un panel antes de que su hoja aplique mostraria el contenido sin estilos:
    // el toque queda retenido y se reintenta en cuanto la hoja llega. `sheet` es null
    // hasta que carga; las enlazadas con media="print" pasan a "all" en su onload.
    function sheetApplied(name) {
      var link = document.querySelector('link[rel="stylesheet"][href*="' + name + '"]');
      if (!link || (link.sheet && link.media !== 'print')) return true;
      link.addEventListener('load', retryPending, { once: true });
      return false;
    }

    function toggleCart() {
      var parts = cartParts();
      // Sin panel lateral (modo popup) el toque sigue el camino retenido.
      if (!parts || !sheetApplied('minicart.css')) return false;
      var open = !parts.panel.classList.contains('open');
      if (typeof parts.cart.open === 'function') {
        if (open) parts.cart.open(); else parts.cart.close();
      } else {
        setCart(parts, open);
      }
      return true;
    }

    function panelOf(trigger) {
      if (trigger.id === 'cart-icon-bubble') return 'Minicart';
      return trigger.matches('.nav-toggle') ? 'Nav' : 'Search';
    }

    // Devuelve true cuando el toque ya tuvo su efecto (o se descarto a proposito).
    function actOn(trigger) {
      var panel = panelOf(trigger);
      // Menu suprimido = ventana del toque fantasma al cerrar el gate: se descarta,
      // igual que hace theme.js.
      if (gateSuppresses('Nav')) return true;
      if (gateSuppresses(panel)) releaseGateSyncHold();
      if (scriptsReady) {
        replaying = true;
        try { trigger.click(); } finally { replaying = false; }
        return true;
      }
      if (panel === 'Nav') {
        if (!sheetApplied('navigation.css')) return false;
        setNav(trigger, !rootEl.classList.contains('nav-open'));
        return true;
      }
      return panel === 'Minicart' && toggleCart();
    }

    function retryPending() {
      var trigger = pendingTrigger;
      if (!trigger || !actOn(trigger)) return;
      window.clearTimeout(pendingTimer);
      pendingTrigger = null;
      trigger.removeAttribute('aria-busy');
    }

    // theme.js ya atiende los tres disparadores: lo retenido se repite y esto se retira.
    function handOver() {
      scriptsReady = true;
      document.removeEventListener('pointerdown', onEarlyTap, true);
      document.removeEventListener('click', onEarlyTap, true);
      retryPending();
    }

    function onEarlyTap(event) {
      if (replaying) return;
      var trigger = event.target && event.target.closest ? event.target.closest(drawerTriggers) : null;
      if (!trigger) return;
      if (!requested && !isAgeVerified()) return;
      loadDeferredAssets();
      if (event.type !== 'click') return;
      // Icono del carrito sin panel que abrir (pagina de carrito, "ir al carrito"):
      // es un enlace normal a /cart y no hay nada que retener.
      if (panelOf(trigger) === 'Minicart' && !trigger.classList.contains('minicart__action')) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if (actOn(trigger)) return;
      pendingTrigger = trigger;
      trigger.setAttribute('aria-busy', 'true');
      // Red de seguridad: si la cadena no resolviera (un script colgado sin onload ni
      // onerror), el toque se libera igual y el <a> del carrito navega a /cart.
      window.clearTimeout(pendingTimer);
      pendingTimer = window.setTimeout(handOver, 8000);
    }

    // Cierres de lo abierto antes de que existan los componentes de theme.js. Queda
    // enganchado: si su script fallara, el panel abierto aqui no tendria como cerrarse.
    function onEarlyDismiss(event) {
      var target = event.target;
      if (!target || !target.closest) return;
      if (rootEl.classList.contains('nav-open') && target.closest('close-menu') && !window.customElements.get('close-menu')) {
        setNav(null, false);
        return;
      }
      if (!earlyCartOpen) return;
      var parts = cartParts();
      if (!parts || typeof parts.cart.close === 'function') return;
      var inside = target.closest('cart-notification, .header__minicart');
      if (inside && !target.closest('.close-cart-button, .close-cart')) return;
      setCart(parts, false);
    }

    document.addEventListener('pointerdown', onEarlyTap, true);
    document.addEventListener('click', onEarlyTap, true);
    document.addEventListener('click', onEarlyDismiss, true);
    window.addEventListener('diyvape:deferred-assets-loaded', handOver, { once: true });
    // El panel del carrito se renderiza al final del <body>. Con el HTML todavia
    // llegando (conexion lenta, estilos en cache) el icono ya se ve y el panel aun no
    // existe: lo retenido por eso se reintenta al terminar el parseo.
    domParsed.then(retryPending);

    // Un carrito abierto antes de existir su componente: open() es idempotente y
    // engancha lo que le falta (cierre al hacer clic fuera, imagenes diferidas).
    if (window.customElements && window.customElements.whenDefined) {
      window.customElements.whenDefined('cart-notification').then(function () {
        var parts = cartParts();
        if (earlyCartOpen && parts && typeof parts.cart.open === 'function') parts.cart.open();
        earlyCartOpen = false;
      });
    }

    window.diyvapeLoadDeferredAssets = loadDeferredAssets;

    window.addEventListener('diyvape:age-verified', function () {
      loadDeferredAssets();
      releasePostGateDynamicAssets();
    }, { once: true });
    document.addEventListener('diyvape:age-verified', function () {
      loadDeferredAssets();
      releasePostGateDynamicAssets();
    }, { once: true });

    if (isAgeVerified()) {
      // Start the deferred bundle (theme.js, global.js, swiper, motion) during idle time
      // instead of the next tick: the burst's script execution then yields to any early
      // tap/click, so a first interaction isn't stuck behind it (INP). 2s timeout caps the
      // wait so features stay ready quickly.
      runWhenIdle(function () {
        loadDeferredAssets();
        releasePostGateDynamicAssets();
      }, 2000);
    } else {
      document.addEventListener('DOMContentLoaded', function () {
        var gate = document.querySelector('age-verification-gate');
        if (!gate || !gate.classList.contains('active') || gate.getAttribute('aria-hidden') === 'true') {
          runWhenIdle(function () {
            loadDeferredAssets();
            releasePostGateDynamicAssets();
          }, 2000);
        }
      }, { once: true });
    }
  })();
</script>
