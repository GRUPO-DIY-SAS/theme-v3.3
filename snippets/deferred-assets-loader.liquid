{%- comment -%}
  Carga diferida de los assets del theme. layout/theme.liquid y scripts-tag
  encolan CSS/JS en window.diyvapeDeferredAssets; aquí arrancan en idle para
  que el burst de ejecución de theme.js/global.js/swiper ceda ante el primer
  tap del usuario (INP). Emite diyvape:deferred-visual-ready cuando el CSS
  visual está aplicado (levanta las reglas FOUC de critical-base y el
  preload-page) y diyvape:deferred-assets-loaded al terminar los scripts.

  Fuera de product page intercepta appendChild/insertBefore para descartar el
  widget de Judge.me: el app embed lo inyecta vía content_for_header en todas
  las páginas y no se puede filtrar server-side, pero las reseñas sólo se
  muestran en PDP. En product page no se parchea nada: overhead cero en la
  ruta de mayor tráfico.

  Los identificadores `diyvape*` son nombres internos heredados del theme base
  (critical-base, preload-page y theme.js los consumen); no son visibles.
{%- endcomment -%}
<script>
  window.diyvapeDeferredAssets = window.diyvapeDeferredAssets || [];
  (function () {
    if (window.diyvapeDeferredLoaderReady) return;

    window.diyvapeDeferredLoaderReady = true;

    var assets = window.diyvapeDeferredAssets;
    var pageType = {{ request.page_type | json }};
    var requested = false;
    var scriptChain = Promise.resolve();
    var loaded = {};
    var loadedPromises = {};
    var visualStylePromises = [];
    // Todas las hojas diferidas (no sólo las 'visual'): critical-base oculta la barra de cookies hasta que
    // llegan, porque su geometría final depende de popup.css/theme.css y el cambio contaba como CLS.
    var stylePromises = [];
    var stylesReady = false;
    var visualReady = false;
    var visualReadyTimer = null;
    var originalPush = assets.push.bind(assets);

    // Scripts de terceros que no aportan al primer render y bloquean el hilo principal en la home
    // (Lighthouse: mercadopago security.js ~1 s de bloqueo, fbevents, RetailCRM). Se retienen y se
    // insertan tras window.load + idle. En carrito/checkout no se retrasan (MercadoPago los necesita).
    // Dos cubos: 'idle' (píxeles/analytics: se cargan tras load+idle para no perder PageViews) e
    // 'interaction' (MercadoPago security.js solo sirve en checkout: se carga a la primera interacción o 10 s tras load).
    // 'drop': no se inserta nunca (Superlemon: desactivado, pendiente de desinstalar la app).
    // 'chat': se retiene hasta que el usuario toca el botón de chat (window.diyvapeFlushChat) — patrón diyvape.co.
    var delayHosts = { 'mercadopago.com': 'interaction', 'mercadolibre.com': 'interaction', 'connect.facebook.net': 'idle', 'retailcrm.tech': 'chat', 'splmn-shopify-prod': 'drop' };
    var delayEnabled = pageType !== 'cart' && pageType !== 'checkout';
    var delayedNodes = [];
    function delayBucket(node) {
      if (!delayEnabled || !node || node.nodeType !== 1 || node.tagName !== 'SCRIPT') return '';
      var url = String(node.src || '').toLowerCase();
      if (!url) return '';
      for (var host in delayHosts) {
        if (url.indexOf(host) !== -1) return delayHosts[host];
      }
      return '';
    }
    var delayedFlushed = { idle: false, interaction: false, chat: false };
    function flushDelayed(bucket) {
      if (delayedFlushed[bucket]) return;
      delayedFlushed[bucket] = true;
      var pending = delayedNodes.filter(function (e) { return e.bucket === bucket; });
      delayedNodes = delayedNodes.filter(function (e) { return e.bucket !== bucket; });
      pending.forEach(function (entry) {
        try { entry.parent.appendChild(entry.node); } catch (e) {}
      });
    }
    var delayScheduled = { idle: false, interaction: false, chat: false };
    function scheduleDelayedFlush(bucket) {
      if (delayScheduled[bucket]) return;
      delayScheduled[bucket] = true;
      var afterLoad = function (fn) {
        if (document.readyState === 'complete') fn();
        else window.addEventListener('load', fn, { once: true });
      };
      if (bucket === 'chat') {
        // sin autoflush: solo window.diyvapeFlushChat() (botón de chat)
      } else if (bucket === 'idle') {
        afterLoad(function () { runWhenIdle(function () { flushDelayed('idle'); }, 4000); });
        window.setTimeout(function () { flushDelayed('idle'); }, 8000);
      } else {
        var onInteract = function () { flushDelayed('interaction'); };
        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (ev) {
          window.addEventListener(ev, onInteract, { once: true, passive: true });
        });
        afterLoad(function () { window.setTimeout(onInteract, 10000); });
      }
    }
    function isReviewWidgetAsset(node) {
      if (!node || node.nodeType !== 1) return false;
      var url = '';
      if (node.tagName === 'SCRIPT') url = node.src || '';
      else if (node.tagName === 'LINK') url = node.href || '';
      url = String(url).toLowerCase();
      return url.indexOf('judge.me') !== -1 || url.indexOf('/judgeme-') !== -1;
    }

    if (pageType !== 'product' || delayEnabled) {
      var originalAppendChild = Node.prototype.appendChild;
      var originalInsertBefore = Node.prototype.insertBefore;

      Node.prototype.appendChild = function (node) {
        if (pageType !== 'product' && isReviewWidgetAsset(node)) return node;
        var bucket = delayBucket(node);
        if (bucket === 'drop') return node;
        if (bucket && !delayedFlushed[bucket]) { delayedNodes.push({ parent: this, node: node, bucket: bucket }); scheduleDelayedFlush(bucket); return node; }
        return originalAppendChild.call(this, node);
      };

      Node.prototype.insertBefore = function (node, referenceNode) {
        if (pageType !== 'product' && isReviewWidgetAsset(node)) return node;
        var bucket = delayBucket(node);
        if (bucket === 'drop') return node;
        if (bucket && !delayedFlushed[bucket]) { delayedNodes.push({ parent: this, node: node, bucket: bucket }); scheduleDelayedFlush(bucket); return node; }
        return originalInsertBefore.call(this, node, referenceNode);
      };
    }

    function runWhenIdle(callback, timeout) {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(callback, { timeout: timeout || 3000 });
      } else {
        window.setTimeout(callback, timeout || 1);
      }
    }

    function markVisualReady() {
      if (visualReady) return;
      visualReady = true;
      document.documentElement.classList.add('diyvape-deferred-visual-ready');
      window.dispatchEvent(new CustomEvent('diyvape:deferred-visual-ready'));
    }

    function markStylesReady() {
      if (stylesReady) return;
      stylesReady = true;
      document.documentElement.classList.add('diyvape-deferred-styles-ready');
      window.dispatchEvent(new CustomEvent('diyvape:deferred-styles-ready'));
    }

    function waitForVisualStyles() {
      if (visualReady) return;
      if (!visualStylePromises.length) {
        markVisualReady();
        return;
      }

      Promise.all(visualStylePromises.slice()).then(markVisualReady);

      if (!visualReadyTimer) {
        visualReadyTimer = window.setTimeout(markVisualReady, 3000);
      }
    }

    function isVisualStyle(asset) {
      return asset && asset.type === 'style' && asset.visual !== false;
    }

    function loadStyle(asset) {
      if (!asset || !asset.href) return Promise.resolve();
      if (loaded[asset.href]) return loadedPromises[asset.href] || Promise.resolve();
      loaded[asset.href] = true;

      loadedPromises[asset.href] = new Promise(function (resolve) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = asset.href;
        link.media = asset.media || 'all';
        link.dataset.diyvapeDeferred = 'true';
        link.onload = resolve;
        link.onerror = resolve;
        document.head.appendChild(link);
      });

      return loadedPromises[asset.href];
    }

    function loadScript(asset) {
      if (!asset || !asset.src) return Promise.resolve();
      if (loaded[asset.src]) return loadedPromises[asset.src] || Promise.resolve();
      loaded[asset.src] = true;

      loadedPromises[asset.src] = new Promise(function (resolve) {
        var script = document.createElement('script');
        script.src = asset.src;
        script.async = false;
        script.defer = true;
        if (asset.module) script.type = 'module';
        if (asset.id) script.id = asset.id;
        script.dataset.diyvapeDeferred = 'true';
        script.onload = resolve;
        script.onerror = resolve;
        document.head.appendChild(script);
      });

      return loadedPromises[asset.src];
    }

    function queueScript(asset) {
      scriptChain = scriptChain.then(function () {
        return loadScript(asset);
      });
      return scriptChain;
    }

    function loadAsset(asset) {
      if (!asset) return;
      if (asset.type === 'style') {
        return loadStyle(asset);
      }
      if (asset.type === 'script') {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            queueScript(asset);
          }, { once: true });
          return Promise.resolve();
        }
        return queueScript(asset);
      }
      return Promise.resolve();
    }

    function loadDeferredAssets() {
      if (requested) return scriptChain;
      requested = true;
      document.documentElement.classList.add('diyvape-deferred-assets-requested');

      assets.slice().forEach(function (asset) {
        var assetPromise = loadAsset(asset);
        if (isVisualStyle(asset)) visualStylePromises.push(assetPromise || Promise.resolve());
        if (asset.type === 'style') stylePromises.push(assetPromise || Promise.resolve());
      });

      waitForVisualStyles();
      Promise.all(stylePromises.slice()).then(markStylesReady);
      window.setTimeout(markStylesReady, 5000);

      scriptChain.then(function () {
        document.documentElement.classList.add('diyvape-deferred-assets-loaded');
        window.dispatchEvent(new CustomEvent('diyvape:deferred-assets-loaded'));
      });

      return scriptChain;
    }

    assets.push = function () {
      var incoming = Array.prototype.slice.call(arguments);
      var result = originalPush.apply(assets, incoming);
      if (requested) {
        incoming.forEach(function (asset) {
          var assetPromise = loadAsset(asset);
          if (!stylesReady && asset.type === 'style') stylePromises.push(assetPromise || Promise.resolve());
          if (!visualReady && isVisualStyle(asset)) {
            visualStylePromises.push(assetPromise || Promise.resolve());
            waitForVisualStyles();
          }
        });
      }
      return result;
    };

    window.diyvapeLoadDeferredAssets = loadDeferredAssets;
    window.diyvapeFlushChat = function () {
      var held = delayedNodes.filter(function (e) { return e.bucket === 'chat'; }).length;
      flushDelayed('chat');
      return held;
    };

    // El CSS visual (critical.css, product-card.css…) arranca ya: main y header siguen ocultos hasta
    // que llega, y esperar al idle añadía ~2 s de render delay al LCP en 4G (los app embeds del head
    // mantienen ocupado el hilo). Los scripts sí esperan al idle (INP).
    assets.slice().forEach(function (asset) {
      if (!isVisualStyle(asset)) return;
      var visualPromise = loadAsset(asset) || Promise.resolve();
      visualStylePromises.push(visualPromise);
      stylePromises.push(visualPromise);
    });
    if (visualStylePromises.length) waitForVisualStyles();
    else markVisualReady(); // el CSS del primer pintado ya es <link> bloqueante en el head

    // Idle con tope de 2s: el burst de scripts cede ante un tap temprano sin retrasar
    // demasiado las features que dependen de theme.js.
    runWhenIdle(loadDeferredAssets, 2000);
  })();
</script>
