{% comment %}
  SEO: LocalBusiness structured data for Homesale's single physical location
  (warehouse + customer service at Celta Trade Park). TinySEO emits a generic
  Store schema but no address/hours. Only renders on the homepage to avoid
  duplication.
{% endcomment %}

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.homesale.com.co#store",
  "name": "Home Sale S.A.S.",
  "description": "Tienda de deportes, bicicletas, equipos de gimnasio, movilidad eléctrica, juguetería y herramientas en Colombia.",
  {%- if settings.logo != blank %}
  "image": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
  {%- endif %}
  "url": "https://www.homesale.com.co",
  "telephone": "+573132882596",
  "email": "servicioalcliente@homesale.com.co",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "KM 7 Vía Bogotá – Medellín, Celta Trade Park, Bodega 3 Lote 33",
    "addressLocality": "Funza",
    "addressRegion": "Cundinamarca",
    "addressCountry": "CO"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "17:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "09:00",
      "closes": "12:00"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/homesalecolombia",
    "https://www.instagram.com/homesalecolombia/"
  ]
}
</script>
{%- endif -%}
