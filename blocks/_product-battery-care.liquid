{%- comment -%}
  Guía de cuidado de la batería para vehículos eléctricos (bicicletas, motos y patinetas).
  Solo se muestra cuando product.type pertenece a la familia eléctrica, así la plantilla
  maestra sirve a todo el catálogo. Cuatro pasos numerados con icono y un aviso de garantía;
  el contenido es editable en los ajustes del bloque.
{%- endcomment -%}
{%- liquid
  assign block_st = block.settings
  assign section_st = section.settings
  assign product = closest.product
  assign enable_skeleton_loading = section_st.enable_skeleton_loading
  assign ptype = product.type | downcase
  assign show = false
  if ptype == 'bicicleta eléctrica' or ptype == 'patinetas eléctricas'
    assign show = true
  endif
  if block_st.extra_types != blank
    assign extra = block_st.extra_types | downcase | split: ','
    for t in extra
      assign tt = t | strip
      if tt == ptype
        assign show = true
      endif
    endfor
  endif
-%}
{%- if show -%}
  <div class="battery-care{% if enable_skeleton_loading %} skeleton-loading{% endif %}" {{ block.shopify_attributes }}>
    <div class="battery-care__head">
      <span class="battery-care__eyebrow">{{ block_st.eyebrow }}</span>
      <h3 class="battery-care__title h5 my-0">{{ block_st.heading }}</h3>
    </div>
    <ol class="battery-care__steps">
      {%- for i in (1..4) -%}
        {%- assign tk = 'step' | append: i | append: '_title' -%}
        {%- assign xk = 'step' | append: i | append: '_text' -%}
        {%- assign t = block_st[tk] -%}
        {%- assign x = block_st[xk] -%}
        {%- if t != blank or x != blank -%}
          <li class="battery-care__step">
            <span class="battery-care__num" aria-hidden="true">{{ i }}</span>
            <span class="battery-care__icon" aria-hidden="true">
              {%- case i -%}
                {%- when 1 -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="M9 15h2l1 2 1-4 1 2h1"/></svg>
                {%- when 2 -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v5M15 3v5"/><path d="M6 8h12v3a6 6 0 0 1-12 0z"/><path d="M12 17v4"/></svg>
                {%- when 3 -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="17" height="10" rx="2"/><path d="M22 10v4"/><path d="M6 11v2"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M5 20V9l7-5 7 5v11"/><path d="M9 20v-5h6v5"/><path d="M12 4v3"/></svg>
              {%- endcase -%}
            </span>
            <span class="battery-care__body">
              <strong class="battery-care__step-title">{{ t }}</strong>
              <span class="battery-care__step-text">{{ x }}</span>
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
    {%- if block_st.footer != blank -%}
      <p class="battery-care__footer">{{ block_st.footer }}</p>
    {%- endif -%}
    {%- if block_st.warning != blank -%}
      <p class="battery-care__warning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 21h20z"/><path d="M12 10v5M12 18h.01"/></svg>
        <span>{{ block_st.warning }}</span>
      </p>
    {%- endif -%}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Cuidado de la batería",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Homesale · Roadmaster" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Dale buen uso a la batería de tu vehículo eléctrico" },
    { "type": "text", "id": "step1_title", "label": "Paso 1 · título", "default": "Cárgala aunque no la uses" },
    { "type": "textarea", "id": "step1_text", "label": "Paso 1 · texto", "default": "Si va a estar guardada, cárgala al menos una vez por semana. Una batería descargada durante semanas pierde capacidad y no la recupera." },
    { "type": "text", "id": "step2_title", "label": "Paso 2 · título", "default": "Desconecta cuando el indicador esté en verde" },
    { "type": "textarea", "id": "step2_text", "label": "Paso 2 · texto", "default": "Cuando el cargador marque carga completa, desconéctalo. Dejarla conectada por horas sobrecarga la batería y acorta su vida útil." },
    { "type": "text", "id": "step3_title", "label": "Paso 3 · título", "default": "Carga con la batería baja, no a medias" },
    { "type": "textarea", "id": "step3_text", "label": "Paso 3 · texto", "default": "Evita poner a cargar con más del 60 % de carga. Lo ideal es cargarla cuando baje del 20 % y completar el ciclo sin interrupciones." },
    { "type": "text", "id": "step4_title", "label": "Paso 4 · título", "default": "Elige bien el lugar de carga" },
    { "type": "textarea", "id": "step4_text", "label": "Paso 4 · texto", "default": "Carga en un espacio ventilado, lejos de materiales inflamables, con el cargador apoyado sobre una superficie plana y firme para evitar el sobrecalentamiento." },
    { "type": "text", "id": "footer", "label": "Cierre", "default": "Un buen uso de la batería mantiene el vehículo en buen estado y alarga su vida útil." },
    { "type": "text", "id": "warning", "label": "Aviso", "default": "Sigue las instrucciones del fabricante: los daños por uso inadecuado de la batería no están cubiertos por la garantía." },
    { "type": "text", "id": "extra_types", "label": "Otros tipos de producto donde mostrarlo (separados por coma)", "info": "Por defecto se muestra en Bicicleta Eléctrica y Patinetas Eléctricas." }
  ],
  "presets": [ { "name": "Cuidado de la batería" } ]
}
{% endschema %}
