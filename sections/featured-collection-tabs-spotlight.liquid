{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign heading = section_st.heading
  assign description = section_st.description
  assign display_mode = section_st.display_mode
  assign product_layout = section_st.product_layout
  assign quick_layout = section_st.quick_layout
  assign card_surface = section_st.card_surface
  assign interaction_effect = section_st.interaction_effect
  assign background_type = section_st.background_type
  assign background_image = section_st.background_image
  assign mobile_background_image = section_st.mobile_background_image | default: background_image
  assign background_video = section_st.background_video
  assign mobile_background_video = section_st.mobile_background_video | default: background_video
  assign background_video_poster = section_st.background_video_poster | default: background_video.preview_image
  assign mobile_background_video_poster = section_st.mobile_background_video_poster | default: mobile_background_video.preview_image | default: background_video_poster
  assign background_video_source = ''
  assign mobile_background_video_source = ''
  assign items_to_show = section_st.items_to_show
  assign items_per_row = section_st.items_per_row
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign column_gap = section_st.column_gap
  assign show_arrow = section_st.show_arrow
  assign carousel_pagination = section_st.carousel_pagination
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  assign show_view_all_button = section_st.show_view_all_button
  assign show_card_title = section_st.show_card_title
  assign show_card_vendor = section_st.show_card_vendor
  assign show_card_price = section_st.show_card_price
  assign show_card_compare_price = section_st.show_card_compare_price
  assign show_card_badges = section_st.show_card_badges
  assign scroll_animation = settings.scroll_animation
  assign header_size = ''
  assign animate_delay = 0
  assign image_ratio = section_st.image_ratio
  assign reset_spacing = ''
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif

  if image_ratio == 'square'
    assign image_ratio_value = '1 / 1'
  elsif image_ratio == 'portrait'
    assign image_ratio_value = '3 / 4'
  elsif image_ratio == 'landscape'
    assign image_ratio_value = '4 / 3'
  elsif image_ratio == 'wide'
    assign image_ratio_value = '16 / 9'
  else
    assign image_ratio_value = 'auto'
  endif

  if items_per_row_mobile > 1 and items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif
  assign grid_mobile_columns = items_per_row_mobile | ceil

  for source in background_video.sources
    if source.format == 'mp4'
      assign background_video_source = source.url
      break
    endif
  endfor

  for source in mobile_background_video.sources
    if source.format == 'mp4'
      assign mobile_background_video_source = source.url
      break
    endif
  endfor
-%}

{%- capture section_style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- capture slider_style -%}
  {% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{ column_gap }}px;{% endif %}
{%- endcapture -%}

{%- if display_mode == 'product_tabs' and product_layout == 'carousel'
  or display_mode == 'quick_collections' and quick_layout == 'carousel'
-%}
  <script>
    (function () {
      var swiperStyle = {{ 'swiper-bundle.min.css' | asset_url | json }};
      var swiperScript = {{ 'swiper-bundle.min.js' | asset_url | json }};
      var assets = [
        { type: 'style', href: swiperStyle },
        { type: 'script', src: swiperScript }
      ];

      window.diyvapeDeferredAssets = window.diyvapeDeferredAssets || [];
      window.diyvapeDeferredAssets.push.apply(window.diyvapeDeferredAssets, assets);

      if (window.diyvapeLoadDeferredAssets) return;

      if (!document.querySelector('link[href="' + swiperStyle + '"]')) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = swiperStyle;
        link.media = 'all';
        document.head.appendChild(link);
      }

      if (!document.querySelector('script[src="' + swiperScript + '"]')) {
        var script = document.createElement('script');
        script.src = swiperScript;
        script.async = false;
        script.defer = true;
        document.head.appendChild(script);
      }
    })();
  </script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .featured-tabs-spotlight {
    --spotlight-bg: {{ section_st.background_color }};
    --spotlight-shape: {{ section_st.shape_color }};
    --spotlight-shape-opacity: {{ section_st.shape_opacity | divided_by: 100.0 }};
    --spotlight-tab-bg: {{ section_st.tab_background }};
    --spotlight-tab-text: {{ section_st.tab_text_color }};
    --spotlight-tab-active-bg: {{ section_st.tab_active_background }};
    --spotlight-tab-active-text: {{ section_st.tab_active_text_color }};
    --spotlight-card-bg: {{ section_st.card_background }};
    --spotlight-card-text: {{ section_st.card_text_color }};
    --spotlight-overlay: {{ section_st.background_overlay_color }};
    --spotlight-overlay-opacity: {{ section_st.background_overlay_opacity | divided_by: 100.0 }};
    --spotlight-image-ratio: {{ image_ratio_value }};
    --spotlight-image-height: {{ section_st.image_height }}px;
    --spotlight-image-height-mobile: {{ section_st.mobile_image_height }}px;
    --spotlight-image-fit: {{ section_st.image_fit }};
    --spotlight-product-cols: {{ items_per_row }};
    --spotlight-product-mobile-cols: {{ grid_mobile_columns }};
    --spotlight-quick-cols: {{ section_st.quick_columns }};
    --spotlight-quick-mobile-cols: {{ section_st.quick_mobile_columns }};
    --spotlight-media-inset-y: {{ section_st.media_padding_y }}px;
    --spotlight-media-inset-x: {{ section_st.media_padding_x }}px;
    --spotlight-media-radius: {{ section_st.media_radius }}px;
    --spotlight-media-height: {{ section_st.media_height }}px;
    --spotlight-media-height-mobile: {{ section_st.mobile_media_height }}px;
    position: relative;
    overflow: hidden;
    background: var(--spotlight-bg);
  }

  /* Media backgrounds frame as an inset hero; 0 defaults keep legacy full-bleed */
  #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-image,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-parallax,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-video {
    min-height: var(--spotlight-media-height, 0);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__background {
    position: absolute;
    inset: var(--spotlight-media-inset-y, 0) var(--spotlight-media-inset-x, 0);
    z-index: 0;
    overflow: hidden;
    border-radius: var(--spotlight-media-radius, 0);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--spotlight-overlay);
    opacity: var(--spotlight-overlay-opacity);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__background img,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight__background video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__background-mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-parallax .featured-tabs-spotlight__background {
    background-image: var(--spotlight-bg-desktop);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-parallax .featured-tabs-spotlight__background img {
    display: none;
  }

  /* Video parallax: scroll-linked transform (compositor-only, no JS). The video
     is oversized so the translate never exposes a gap; overflow on the wrapper clips it. */
  @supports (animation-timeline: view()) {
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--video-parallax .featured-tabs-spotlight__background video {
      height: 150%;
      animation: spotlightVideoParallax linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }
  }

  @keyframes spotlightVideoParallax {
    from {
      transform: translateY(-30%);
    }

    to {
      transform: translateY(0%);
    }
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__shape {
    position: absolute;
    z-index: 1;
    background: var(--spotlight-shape);
    opacity: var(--spotlight-shape-opacity);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-none .featured-tabs-spotlight__shape {
    display: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-diamond .featured-tabs-spotlight__shape {
    width: min(132vw, 1900px);
    height: min(132vw, 1900px);
    top: 0;
    left: 50%;
    border-radius: 100px;
    transform: translate(-50%, -84%) rotate(45deg);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-arch .featured-tabs-spotlight__shape {
    width: min(122vw, 1760px);
    height: min(58vw, 620px);
    top: -18%;
    left: 50%;
    border-radius: 0 0 999px 999px;
    transform: translateX(-50%);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-circle .featured-tabs-spotlight__shape {
    width: min(92vw, 1180px);
    height: min(92vw, 1180px);
    top: -62%;
    left: 50%;
    border-radius: 50%;
    transform: translateX(-50%);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-ribbon .featured-tabs-spotlight__shape {
    width: 140vw;
    height: 420px;
    top: -170px;
    left: -20vw;
    border-radius: 90px;
    transform: rotate(-6deg);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-motion .featured-tabs-spotlight__shape {
    animation: spotlightShapeDrift 12s ease-in-out infinite alternate;
  }

  @keyframes spotlightShapeDrift {
    from {
      filter: saturate(1);
    }

    to {
      filter: saturate(1.12);
    }
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__inner {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__header {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 32px;
    padding: 0 1.5rem 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__tabs::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab {
    flex: 0 0 auto;
    min-height: 46px;
    padding: 13px 34px;
    border: 1px solid var(--spotlight-tab-bg);
    border-radius: 999px;
    background: var(--spotlight-tab-bg);
    color: var(--spotlight-tab-text);
    line-height: 1;
    text-align: center;
    transition: background-color 0.22s ease, border-color 0.22s ease, color 0.22s ease, transform 0.22s ease;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab:hover,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab.active {
    border-color: var(--spotlight-tab-active-bg);
    background: var(--spotlight-tab-active-bg);
    color: var(--spotlight-tab-active-text);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab:hover {
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__content {
    position: relative;
    margin-top: 38px;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card {
    height: 100%;
    color: var(--spotlight-card-text);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__inner {
    display: flex;
    height: 100%;
    min-height: 100%;
    flex-direction: column;
    padding: clamp(12px, 1.4vw, 20px);
    border-radius: 22px;
    background: var(--spotlight-card-bg);
    transition: border-color 0.24s ease, box-shadow 0.24s ease, transform 0.24s ease;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--cards-glass .featured-tabs-spotlight-card__inner {
    border: 1px solid color-mix(in srgb, var(--spotlight-card-bg) 48%, #fff 38%);
    background: color-mix(in srgb, var(--spotlight-card-bg) 74%, transparent);
    backdrop-filter: blur(18px) saturate(1.16);
    -webkit-backdrop-filter: blur(18px) saturate(1.16);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--cards-lifted .featured-tabs-spotlight-card__inner {
    box-shadow: 0 18px 45px rgba(18, 18, 18, 0.1);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-lift .featured-tabs-spotlight-card:hover .featured-tabs-spotlight-card__inner,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-sheen .featured-tabs-spotlight-card:hover .featured-tabs-spotlight-card__inner {
    transform: translateY(-6px);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: {{ section_st.image_radius }}px;
    background: color-mix(in srgb, var(--spotlight-card-bg) 80%, #000 6%);
    {% if image_ratio == 'fixed' %}
      height: var(--spotlight-image-height);
    {% else %}
      aspect-ratio: var(--spotlight-image-ratio);
    {% endif %}
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__media::after,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__media::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 8%, rgba(255, 255, 255, 0.38) 42%, transparent 62%);
    transform: translateX(-120%);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-sheen .featured-tabs-spotlight-card:hover .featured-tabs-spotlight-card__media::after,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-sheen .featured-tabs-spotlight-quick__item:hover .featured-tabs-spotlight-quick__media::after {
    opacity: 1;
    transform: translateX(120%);
    transition: transform 0.75s ease, opacity 0.18s ease;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__media img,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--spotlight-image-fit);
    object-position: center;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card--fixed .featured-tabs-spotlight-card__media,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__item--fixed .featured-tabs-spotlight-quick__media {
    height: var(--spotlight-image-height);
    aspect-ratio: auto;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__media:hover img {
    transform: scale(1.035);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-products {
    display: grid;
    grid-template-columns: repeat(var(--spotlight-product-cols), minmax(0, 1fr));
    gap: var(--col-gap-desktop, var(--col-gap, 20px));
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-products .swiper-slide {
    width: auto !important;
  }

  /* Pre-init (deferred/lazy) carousel: size slides to the per-view width so the
     first frame matches the initialized layout instead of one full-width slide */
  #shopify-section-{{ section.id }} .collection-tab__tab-content .swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    gap: var(--col-gap-desktop, var(--col-gap, 20px));
  }

  #shopify-section-{{ section.id }} .collection-tab__tab-content .swiper:not(.swiper-initialized) .swiper-slide {
    width: calc((100% - var(--col-gap-desktop, var(--col-gap, 20px)) * (var(--spotlight-product-cols) - 1)) / var(--spotlight-product-cols));
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-products--hero_cards .featured-tabs-spotlight-card:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-products--hero_cards .featured-tabs-spotlight-card:first-child .featured-tabs-spotlight-card__media {
    min-height: min(62vw, 620px);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 16px 2px 0;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__vendor,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__eyebrow {
    opacity: 0.68;
    font-size: 12px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__title {
    margin: 0;
    color: var(--spotlight-card-text);
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__price {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    margin-top: auto;
    color: var(--spotlight-card-text);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__compare {
    opacity: 0.55;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    padding: 6px 10px;
    border-radius: 999px;
    background: {{ section_st.badge_background }};
    color: {{ section_st.badge_text_color }};
    font-size: 12px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__view-all {
    margin-top: 32px;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab-cta {
    margin-top: 30px;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick {
    display: grid;
    grid-template-columns: repeat(var(--spotlight-quick-cols), minmax(0, 1fr));
    gap: var(--col-gap, 20px);
    margin-top: 38px;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick.swiper {
    display: block;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick.swiper .swiper-wrapper {
    display: flex;
    gap: 0;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick.swiper:not(.swiper-initialized) .swiper-wrapper {
    gap: var(--col-gap, 20px);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick.swiper:not(.swiper-initialized) .swiper-slide {
    width: calc((100% - var(--col-gap, 20px) * (var(--spotlight-quick-cols) - 1)) / var(--spotlight-quick-cols));
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__item {
    display: block;
    color: var(--spotlight-card-text);
    text-decoration: none;
    transition: transform 0.24s ease;
    /* iOS Safari fails to paint a slide inside the transformed Swiper wrapper
       (first card was vanishing); own compositing layer keeps it painted. */
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-lift .featured-tabs-spotlight-quick__item:hover,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-sheen .featured-tabs-spotlight-quick__item:hover {
    transform: translateY(-5px);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: {{ section_st.image_radius }}px;
    background: color-mix(in srgb, var(--spotlight-card-bg) 80%, #000 6%);
    {% if image_ratio == 'fixed' %}
      height: var(--spotlight-image-height);
    {% else %}
      aspect-ratio: var(--spotlight-image-ratio);
    {% endif %}
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__media img,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--spotlight-image-fit);
    object-position: center;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__item:hover img {
    transform: scale(1.035);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__body {
    padding-top: 14px;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__body--surface {
    margin-top: 14px;
    padding: clamp(14px, 1.4vw, 20px);
    border-radius: 18px;
    color: var(--spotlight-card-text);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__body--solid {
    background: var(--spotlight-card-bg);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__body--glass {
    border: 1px solid color-mix(in srgb, var(--spotlight-card-bg) 48%, #fff 38%);
    /* No backdrop-filter: it can't sample a backdrop inside Swiper's transformed
       wrapper and triggers an iOS Safari repaint bug that hides the card. The
       translucent fill keeps the frosted look. */
    background: color-mix(in srgb, var(--spotlight-card-bg) 86%, transparent);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__title {
    margin: 0;
    color: var(--spotlight-card-text);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__subtitle {
    margin-top: 4px;
    opacity: 0.72;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__eyebrow {
    opacity: 0.68;
    font-size: 12px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__title-link {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__text {
    margin-top: 8px;
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__item.text-center .featured-tabs-spotlight-quick__buttons {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__item.text-right .featured-tabs-spotlight-quick__buttons {
    justify-content: flex-end;
  }

  @supports (animation-timeline: view()) {
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-reveal .featured-tabs-spotlight-card,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-reveal .featured-tabs-spotlight-quick__item {
      animation: spotlightCardReveal both;
      animation-timeline: view();
      animation-range: entry 8% cover 28%;
    }
  }

  @keyframes spotlightCardReveal {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-motion .featured-tabs-spotlight__shape,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--video-parallax .featured-tabs-spotlight__background video,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-reveal .featured-tabs-spotlight-card,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--fx-reveal .featured-tabs-spotlight-quick__item {
      animation: none;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__inner,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__item,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__media img,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__media img {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-diamond .featured-tabs-spotlight__shape {
      width: 940px;
      height: 940px;
      transform: translate(-50%, -78%) rotate(45deg);
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-arch .featured-tabs-spotlight__shape {
      width: 980px;
      height: 420px;
      top: -210px;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-circle .featured-tabs-spotlight__shape {
      width: 760px;
      height: 760px;
      top: -470px;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight--shape-ribbon .featured-tabs-spotlight__shape {
      height: 320px;
      top: -150px;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight__tabs {
      justify-content: flex-start;
      margin-left: -1.5rem;
      margin-right: -1.5rem;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-image,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-parallax,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-video {
      min-height: var(--spotlight-media-height-mobile, 0);
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight__background-desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight__background-mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight--bg-parallax .featured-tabs-spotlight__background {
      background-image: var(--spotlight-bg-mobile);
      background-attachment: scroll;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab {
      min-height: 42px;
      padding: 12px 24px;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__media {
      {% if image_ratio == 'fixed' %}
        height: var(--spotlight-image-height-mobile);
      {% endif %}
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card--fixed .featured-tabs-spotlight-card__media,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__item--fixed .featured-tabs-spotlight-quick__media {
      height: var(--spotlight-image-height-mobile);
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-products {
      grid-template-columns: repeat(var(--spotlight-product-mobile-cols), minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-products--hero_cards .featured-tabs-spotlight-card:first-child {
      grid-column: auto;
      grid-row: auto;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-products--hero_cards .featured-tabs-spotlight-card:first-child .featured-tabs-spotlight-card__media {
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick {
      grid-template-columns: repeat(var(--spotlight-quick-mobile-cols), minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .collection-tab__tab-content .swiper:not(.swiper-initialized) .swiper-slide {
      width: calc((100% - var(--col-gap, 20px) * (var(--spotlight-product-mobile-cols) - 1)) / var(--spotlight-product-mobile-cols));
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick.swiper:not(.swiper-initialized) .swiper-slide {
      width: calc((100% - var(--col-gap, 20px) * (var(--spotlight-quick-mobile-cols) - 1)) / var(--spotlight-quick-mobile-cols));
    }

    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__media {
      {% if image_ratio == 'fixed' %}
        height: var(--spotlight-image-height-mobile);
      {% endif %}
    }
  }

  /* Per-text font-size overrides; 0 keeps the theme/class default for that text */
  {%- if section_st.text_size_heading > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight__header .section__header-heading { font-size: {{ section_st.text_size_heading }}px; }
  {%- endif -%}
  {%- if section_st.text_size_description > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight__header .section__header-des { font-size: {{ section_st.text_size_description }}px; }
  {%- endif -%}
  {%- if section_st.text_size_tab > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab { font-size: {{ section_st.text_size_tab }}px; }
  {%- endif -%}
  {%- if section_st.text_size_card_title > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__title { font-size: {{ section_st.text_size_card_title }}px; }
  {%- endif -%}
  {%- if section_st.text_size_card_meta > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__vendor,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__eyebrow { font-size: {{ section_st.text_size_card_meta }}px; }
  {%- endif -%}
  {%- if section_st.text_size_card_price > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__price { font-size: {{ section_st.text_size_card_price }}px; }
  {%- endif -%}
  {%- if section_st.text_size_quick_title > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__title { font-size: {{ section_st.text_size_quick_title }}px; }
  {%- endif -%}
  {%- if section_st.text_size_quick_subtitle > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__subtitle { font-size: {{ section_st.text_size_quick_subtitle }}px; }
  {%- endif -%}
{%- endstyle -%}

<div
  class="section featured-tabs-spotlight featured-tabs-spotlight--shape-{{ section_st.shape_style }} featured-tabs-spotlight--bg-{{ background_type }} featured-tabs-spotlight--mode-{{ display_mode }} featured-tabs-spotlight--layout-{{ product_layout }} featured-tabs-spotlight--quick-layout-{{ quick_layout }} featured-tabs-spotlight--cards-{{ card_surface }} featured-tabs-spotlight--fx-{{ interaction_effect }} color-{{ color_scheme }} gradient{% if section_st.animate_shape %} featured-tabs-spotlight--shape-motion{% endif %}{% if background_type == 'video' and section_st.video_parallax %} featured-tabs-spotlight--video-parallax{% endif %}{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %}{{ reset_spacing }}"
  style="{{ section_style | strip | strip_newlines }}"
>
  {%- if background_type == 'image' or background_type == 'parallax' -%}
    <div
      class="featured-tabs-spotlight__background"
      {% if background_type == 'parallax' and background_image != blank %}
        style="--spotlight-bg-desktop: url('{{ background_image | image_url: width: 2400 }}'); --spotlight-bg-mobile: url('{{ mobile_background_image | image_url: width: 1200 }}');"
      {% endif %}
    >
      {%- if background_image != blank -%}
        {{ background_image | image_url: width: 2400 | image_tag: class: 'featured-tabs-spotlight__background-desktop', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: heading }}
      {%- endif -%}
      {%- if mobile_background_image != blank -%}
        {{ mobile_background_image | image_url: width: 1200 | image_tag: class: 'featured-tabs-spotlight__background-mobile', widths: '375, 550, 750, 950, 1200', sizes: '100vw', loading: 'lazy', alt: heading }}
      {%- endif -%}
    </div>
  {%- elsif background_type == 'video' -%}
    <div class="featured-tabs-spotlight__background">
      {%- if background_video_source != blank -%}
        <video
          class="featured-tabs-spotlight__background-desktop lazy-video"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          data-video-load="interaction"
          data-no-idle="true"
          data-src="{{ background_video_source }}"
          {% if background_video_poster != blank %}
            data-poster="{{ background_video_poster | image_url: width: 1800 }}"
            poster="{{ background_video_poster | image_url: width: 1800 }}"
          {% endif %}
        ></video>
      {%- endif -%}
      {%- if mobile_background_video_source != blank -%}
        <video
          class="featured-tabs-spotlight__background-mobile lazy-video"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          data-video-load="interaction"
          data-no-idle="true"
          data-src="{{ mobile_background_video_source }}"
          {% if mobile_background_video_poster != blank %}
            data-poster="{{ mobile_background_video_poster | image_url: width: 900 }}"
            poster="{{ mobile_background_video_poster | image_url: width: 900 }}"
          {% endif %}
        ></video>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="featured-tabs-spotlight__shape"></div>
  <div class="{{ section_width }} featured-tabs-spotlight__inner">
    {%- if display_mode == 'product_tabs' -%}
      <tab-items data-type="horizontal">
    {%- endif -%}
      {%- if heading != blank or description != blank -%}
        <div class="featured-tabs-spotlight__header section__header text-{{ section_st.header_alignment }}">
          {%- if heading != blank -%}
            <motion-element
              data-motion="{{ scroll_animation }}"
              data-motion-delay="{{ animate_delay }}"
              {% if scroll_animation == 'none' %}
                hold
              {% endif %}
              class="block"
            >
              <h2 class="section__header-heading heading-letter-spacing {{ header_size }} mt-0{% if description != blank %} mb-10{% else %} mb-0{% endif %}">
                {{ heading }}
              </h2>
            </motion-element>
          {%- endif -%}
          {%- if description != blank -%}
            {%- assign animate_delay = animate_delay | plus: 50 -%}
            <motion-element
              data-motion="{{ scroll_animation }}"
              data-motion-delay="{{ animate_delay }}"
              {% if scroll_animation == 'none' %}
                hold
              {% endif %}
              class="section__header-des rich__text-m0 block"
            >
              {{ description }}
            </motion-element>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if display_mode == 'quick_collections' -%}
        {%- if quick_layout == 'carousel' -%}
          <slide-section
            class="featured-tabs-spotlight-quick swiper"
            data-section-id="{{ section.id }}"
            data-autoplay="{{ autoplay }}"
            data-effect="slide"
            data-loop="{{ infinite }}"
            data-speed="800"
            data-autoplay-speed="{{ autorotate_speed }}"
            data-spacing="{{ column_gap }}"
            data-mobile="{{ section_st.quick_mobile_columns }}"
            data-tablet="3"
            data-desktop="{{ section_st.quick_columns }}"
            data-free-scroll="true"
            data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
            data-arrow-centerimage="1"
            style="{{ slider_style | strip | strip_newlines }}"
          >
            {%- if show_arrow -%}
              {%- render 'swiper-navigation' -%}
            {%- endif -%}
            <div class="swiper-wrapper">
        {%- else -%}
          <div class="featured-tabs-spotlight-quick" style="{{ slider_style | strip | strip_newlines }}">
        {%- endif -%}
          {%- assign quick_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'quick_collection' -%}
              {%- liquid
                assign quick_count = quick_count | plus: 1
                assign block_st = block.settings
                assign collection = block_st.collection
                assign quick_title = block_st.title | default: collection.title | default: 'Collection'
                assign quick_subtitle = block_st.subtitle
                assign quick_eyebrow = block_st.eyebrow
                assign quick_description = block_st.description
                assign quick_image = block_st.custom_image | default: collection.image
                assign quick_link = block_st.custom_link | default: collection.url | default: '#'
                assign quick_ratio = block_st.image_ratio
                assign quick_btn1_label = block_st.button_label
                assign quick_btn1_link = block_st.button_link | default: quick_link
                assign quick_btn2_label = block_st.button_label_2
                assign quick_btn2_link = block_st.button_link_2 | default: quick_link
              -%}
              <div
                class="featured-tabs-spotlight-quick__item text-{{ block_st.text_alignment }}{% if quick_layout == 'carousel' %} swiper-slide{% endif %}{% if quick_ratio == 'fixed' %} featured-tabs-spotlight-quick__item--fixed{% endif %}"
                {{ block.shopify_attributes }}
                {% if quick_ratio == 'fixed' %}
                  style="--spotlight-image-height: {{ block_st.image_height }}px;--spotlight-image-height-mobile: {{ block_st.mobile_image_height }}px;--spotlight-image-fit: {{ block_st.image_fit }};"
                {% elsif quick_ratio != 'inherit' %}
                  style="--spotlight-image-ratio: {% if quick_ratio == 'square' %}1 / 1{% elsif quick_ratio == 'portrait' %}3 / 4{% elsif quick_ratio == 'landscape' %}4 / 3{% else %}16 / 9{% endif %};--spotlight-image-fit: {{ block_st.image_fit }};"
                {% else %}
                  style="--spotlight-image-fit: {{ block_st.image_fit }};"
                {% endif %}
              >
                <a class="featured-tabs-spotlight-quick__media" href="{{ quick_link }}" aria-label="{{ quick_title | escape }}">
                  {%- if quick_image != blank -%}
                    {{ quick_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 760, 900', sizes: '(min-width: 1025px) 25vw, 80vw', loading: 'lazy', alt: quick_title }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                <div class="featured-tabs-spotlight-quick__body{% if block_st.text_surface != 'none' %} featured-tabs-spotlight-quick__body--surface featured-tabs-spotlight-quick__body--{{ block_st.text_surface }}{% endif %}">
                  {%- if quick_eyebrow != blank -%}
                    <span class="featured-tabs-spotlight-quick__eyebrow block">{{ quick_eyebrow }}</span>
                  {%- endif -%}
                  <a class="featured-tabs-spotlight-quick__title-link block" href="{{ quick_link }}">
                    <span class="featured-tabs-spotlight-quick__title h4 block">{{ quick_title }}</span>
                  </a>
                  {%- if quick_subtitle != blank -%}
                    <span class="featured-tabs-spotlight-quick__subtitle block">{{ quick_subtitle }}</span>
                  {%- endif -%}
                  {%- if quick_description != blank -%}
                    <div class="featured-tabs-spotlight-quick__text rich__text-m0">{{ quick_description }}</div>
                  {%- endif -%}
                  {%- if quick_btn1_label != blank or quick_btn2_label != blank -%}
                    <div class="featured-tabs-spotlight-quick__buttons">
                      {%- if quick_btn1_label != blank -%}
                        <a class="btn-primary no-underline inline-flex" href="{{ quick_btn1_link }}">{{ quick_btn1_label }}</a>
                      {%- endif -%}
                      {%- if quick_btn2_label != blank -%}
                        <a class="btn-outline no-underline inline-flex" href="{{ quick_btn2_link }}">{{ quick_btn2_label }}</a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if quick_count == 0 -%}
            {%- for i in (1..4) -%}
              <a class="featured-tabs-spotlight-quick__item{% if quick_layout == 'carousel' %} swiper-slide{% endif %}" href="#">
                <span class="featured-tabs-spotlight-quick__media">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </span>
                <span class="featured-tabs-spotlight-quick__body">
                  <span class="featured-tabs-spotlight-quick__title h4 block">{{ 'onboarding.collection_title' | t }}</span>
                </span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- if quick_layout == 'carousel' -%}
            </div>
            {%- if carousel_pagination == 'show_dots'
              or carousel_pagination == 'show_dots_on_mobile'
              or carousel_pagination == 'show_progress_bar'
            -%}
              <div
                class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center"
                style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
              ></div>
            {%- endif -%}
          </slide-section>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- else -%}
      {%- assign tab_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' -%}
          {%- assign tab_index = tab_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if tab_index > 0 -%}
        <div class="featured-tabs-spotlight__tabs" role="tablist" aria-label="{{ heading | default: 'Featured collections' | escape }}">
          {%- assign tab_button_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' -%}
              {%- liquid
                assign tab_button_index = tab_button_index | plus: 1
                assign block_st = block.settings
                assign collection = block_st.collection
                assign collection_title = block_st.collection_title | default: collection.title
              -%}
              <button
                type="button"
                class="featured-tabs-spotlight__tab collection-tab__tab-item heading-style{% if tab_button_index == 1 %} active{% endif %}"
                data-block-id="{{ block.id }}"
                data-style="spotlight"
                role="tab"
                aria-selected="{% if tab_button_index == 1 %}true{% else %}false{% endif %}"
                tabindex="{% if tab_button_index == 1 %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if collection_title != blank -%}
                  {{ collection_title }}
                {%- else -%}
                  {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="featured-tabs-spotlight__content tab-content">
          {%- assign tab_content_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' -%}
              {%- liquid
                assign tab_content_index = tab_content_index | plus: 1
                assign block_st = block.settings
                assign collection = block_st.collection
                assign tab_key = block_st.tab_key | default: collection.handle | default: block.id
                assign collection_url = collection.url | default: '#'
                assign tab_cta_label = block_st.cta_label
                assign tab_cta_link = block_st.cta_link | default: collection_url
                assign custom_product_count = 0
              -%}
              {%- for product_block in section.blocks -%}
                {%- if product_block.type == 'custom_product' and product_block.settings.tab_key == tab_key -%}
                  {%- assign custom_product_count = custom_product_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              <div
                class="collection-tab__tab-content{% if tab_content_index == 1 %} active{% else %} hidden{% endif %}"
                data-block-id="{{ block.id }}"
                data-collection-url="{{ tab_cta_link }}"
              >
                <slide-section
                  class="{% if product_layout == 'carousel' %}swiper{% else %}featured-tabs-spotlight__products-shell{% endif %}"
                  data-section-id="{{ section.id }}"
                  data-block-id="{{ block.id }}"
                  data-autoplay="{{ autoplay }}"
                  data-effect="slide"
                  data-loop="{{ infinite }}"
                  data-speed="800"
                  data-autoplay-speed="{{ autorotate_speed }}"
                  data-spacing="{{ column_gap }}"
                  data-mobile="{{ items_per_row_mobile }}"
                  data-tablet="3"
                  data-desktop="{{ items_per_row }}"
                  data-free-scroll="{{ data_free_scroll }}"
                  data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
                  data-arrow-centerimage="1"
                >
                  {%- if product_layout == 'carousel' and show_arrow -%}
                    {%- render 'swiper-navigation' -%}
                  {%- endif -%}
                  <div
                    class="{% if product_layout == 'carousel' %}swiper-wrapper{% else %}featured-tabs-spotlight-products featured-tabs-spotlight-products--{{ product_layout }}{% endif %}"
                    style="{{ slider_style | strip | strip_newlines }}"
                  >
                    {%- if custom_product_count > 0 -%}
                      {%- assign rendered_custom_products = 0 -%}
                      {%- for product_block in section.blocks -%}
                        {%- if product_block.type == 'custom_product' and product_block.settings.tab_key == tab_key and rendered_custom_products < items_to_show -%}
                          {%- liquid
                            assign product_block_st = product_block.settings
                            assign product = product_block_st.product
                            assign product_image = product_block_st.custom_image | default: product.featured_image | default: collection.image
                            assign product_title = product_block_st.title | default: product.title | default: 'Product title'
                            assign product_url = product.url | default: product_block_st.custom_link | default: '#'
                            assign product_eyebrow = product_block_st.eyebrow | default: product.vendor
                            assign product_badge = product_block_st.badge_text
                            assign card_ratio = product_block_st.image_ratio
                            assign rendered_custom_products = rendered_custom_products | plus: 1
                          -%}
                          <div
                            class="featured-tabs-spotlight-card swiper-slide{% if card_ratio == 'fixed' %} featured-tabs-spotlight-card--fixed{% endif %}"
                            {{ product_block.shopify_attributes }}
                            {% if card_ratio == 'fixed' %}
                              style="--spotlight-image-height: {{ product_block_st.image_height }}px;--spotlight-image-height-mobile: {{ product_block_st.mobile_image_height }}px;--spotlight-image-fit: {{ product_block_st.image_fit }};"
                            {% elsif card_ratio != 'inherit' %}
                              style="--spotlight-image-ratio: {% if card_ratio == 'square' %}1 / 1{% elsif card_ratio == 'portrait' %}3 / 4{% elsif card_ratio == 'landscape' %}4 / 3{% else %}16 / 9{% endif %};--spotlight-image-fit: {{ product_block_st.image_fit }};"
                            {% else %}
                              style="--spotlight-image-fit: {{ product_block_st.image_fit }};"
                            {% endif %}
                          >
                            <div class="featured-tabs-spotlight-card__inner">
                              <a class="featured-tabs-spotlight-card__media" href="{{ product_url }}" aria-label="{{ product_title | escape }}">
                                {%- if show_card_badges and product_badge != blank -%}
                                  <span class="featured-tabs-spotlight-card__badge">{{ product_badge }}</span>
                                {%- endif -%}
                                {%- if product_image != blank -%}
                                  {{ product_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 760, 900', sizes: '(min-width: 1025px) 25vw, 80vw', loading: 'lazy', alt: product_title }}
                                {%- else -%}
                                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                {%- endif -%}
                              </a>
                              <div class="featured-tabs-spotlight-card__body">
                                {%- if show_card_vendor and product_eyebrow != blank -%}
                                  <div class="featured-tabs-spotlight-card__eyebrow">{{ product_eyebrow }}</div>
                                {%- endif -%}
                                {%- if show_card_title -%}
                                  <h3 class="featured-tabs-spotlight-card__title h5">
                                    <a href="{{ product_url }}">{{ product_title }}</a>
                                  </h3>
                                {%- endif -%}
                                {%- if show_card_price and product != blank -%}
                                  <div class="featured-tabs-spotlight-card__price">
                                    {%- if show_card_compare_price and product.compare_at_price > product.price -%}
                                      <span class="featured-tabs-spotlight-card__compare">{{ product.compare_at_price | money }}</span>
                                    {%- endif -%}
                                    <span>{{ product.price | money }}</span>
                                  </div>
                                {%- endif -%}
                              </div>
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- elsif block_st.products != blank -%}
                      {%- for product in block_st.products limit: items_to_show -%}
                        {%- liquid
                          assign product_image = product.featured_image | default: collection.image
                          assign product_title = product.title | default: 'Product title'
                        -%}
                        <div class="featured-tabs-spotlight-card swiper-slide">
                          <div class="featured-tabs-spotlight-card__inner">
                            <a class="featured-tabs-spotlight-card__media" href="{{ product.url }}" aria-label="{{ product_title | escape }}">
                              {%- if product_image != blank -%}
                                {{ product_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 760, 900', sizes: '(min-width: 1025px) 25vw, 80vw', loading: 'lazy', alt: product_title }}
                              {%- else -%}
                                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                              {%- endif -%}
                            </a>
                            <div class="featured-tabs-spotlight-card__body">
                              {%- if show_card_vendor and product.vendor != blank -%}
                                <div class="featured-tabs-spotlight-card__vendor">{{ product.vendor }}</div>
                              {%- endif -%}
                              {%- if show_card_title -%}
                                <h3 class="featured-tabs-spotlight-card__title h5">
                                  <a href="{{ product.url }}">{{ product_title }}</a>
                                </h3>
                              {%- endif -%}
                              {%- if show_card_price -%}
                                <div class="featured-tabs-spotlight-card__price">
                                  {%- if show_card_compare_price and product.compare_at_price > product.price -%}
                                    <span class="featured-tabs-spotlight-card__compare">{{ product.compare_at_price | money }}</span>
                                  {%- endif -%}
                                  <span>{{ product.price | money }}</span>
                                </div>
                              {%- endif -%}
                            </div>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- elsif collection.products.size > 0 -%}
                      {%- for product in collection.products limit: items_to_show -%}
                        {%- liquid
                          assign product_image = product.featured_image | default: collection.image
                          assign product_title = product.title | default: 'Product title'
                        -%}
                        <div class="featured-tabs-spotlight-card swiper-slide">
                          <div class="featured-tabs-spotlight-card__inner">
                            <a class="featured-tabs-spotlight-card__media" href="{{ product.url }}" aria-label="{{ product_title | escape }}">
                              {%- if product_image != blank -%}
                                {{ product_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 760, 900', sizes: '(min-width: 1025px) 25vw, 80vw', loading: 'lazy', alt: product_title }}
                              {%- else -%}
                                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                              {%- endif -%}
                            </a>
                            <div class="featured-tabs-spotlight-card__body">
                              {%- if show_card_vendor and product.vendor != blank -%}
                                <div class="featured-tabs-spotlight-card__vendor">{{ product.vendor }}</div>
                              {%- endif -%}
                              {%- if show_card_title -%}
                                <h3 class="featured-tabs-spotlight-card__title h5">
                                  <a href="{{ product.url }}">{{ product_title }}</a>
                                </h3>
                              {%- endif -%}
                              {%- if show_card_price -%}
                                <div class="featured-tabs-spotlight-card__price">
                                  {%- if show_card_compare_price and product.compare_at_price > product.price -%}
                                    <span class="featured-tabs-spotlight-card__compare">{{ product.compare_at_price | money }}</span>
                                  {%- endif -%}
                                  <span>{{ product.price | money }}</span>
                                </div>
                              {%- endif -%}
                            </div>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for i in (1..items_to_show) -%}
                        <div class="featured-tabs-spotlight-card swiper-slide">
                          <div class="featured-tabs-spotlight-card__inner">
                            <div class="featured-tabs-spotlight-card__media">
                              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                            <div class="featured-tabs-spotlight-card__body">
                              {%- if show_card_vendor -%}
                                <div class="featured-tabs-spotlight-card__eyebrow">Vendor</div>
                              {%- endif -%}
                              {%- if show_card_title -%}
                                <h3 class="featured-tabs-spotlight-card__title h5">
                                  Product title
                                </h3>
                              {%- endif -%}
                              {%- if show_card_price -%}
                                <div class="featured-tabs-spotlight-card__price">{{ 1999 | money }}</div>
                              {%- endif -%}
                            </div>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                  {%- if product_layout == 'carousel' -%}
                    {%- if carousel_pagination == 'show_dots'
                      or carousel_pagination == 'show_dots_on_mobile'
                      or carousel_pagination == 'show_progress_bar'
                    -%}
                      <div
                        class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center"
                        style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
                      ></div>
                    {%- endif -%}
                  {%- endif -%}
                </slide-section>
                  {%- if tab_cta_label != blank -%}
                    <div class="featured-tabs-spotlight__tab-cta text-center">
                      <a class="btn-primary no-underline inline-flex" href="{{ tab_cta_link }}">
