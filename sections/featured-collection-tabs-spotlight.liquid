                assign tab_content_index = tab_content_index | plus: 1
                assign block_st = block.settings
                assign collection = block_st.collection
                assign tab_key = block_st.tab_key | default: collection.handle | default: block.id
                assign collection_url = collection.url | default: '#'
                assign tab_cta_label = block_st.cta_label
                assign tab_cta_link = block_st.cta_link | default: collection_url
                assign custom_product_count = 0
              -%}
              {%- for product_block in section.blocks -%}
                {%- if product_block.type == 'custom_product' and product_block.settings.tab_key == tab_key -%}
