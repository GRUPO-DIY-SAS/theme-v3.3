                                {%- endif -%}
                                {%- if show_card_title -%}
                                  <h3 class="featured-tabs-spotlight-card__title h5">
                                    <a href="{{ product_url }}">{{ product_title }}</a>
                                  </h3>
                                {%- endif -%}
                                {%- render 'spotlight-card-rating', product: product, show_rating: show_card_rating -%}
                                {%- if show_card_price and product != blank -%}
                                  <div class="featured-tabs-spotlight-card__price">
