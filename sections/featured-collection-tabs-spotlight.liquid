          {%- assign tab_button_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' -%}
              {%- liquid
                assign tab_button_index = tab_button_index | plus: 1
                assign block_st = block.settings
                assign collection = block_st.collection
                assign collection_title = block_st.collection_title | default: collection.title
              -%}
              <button
