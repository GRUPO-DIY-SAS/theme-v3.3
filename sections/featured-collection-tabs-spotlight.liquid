                              style="--spotlight-image-height: {{ product_block_st.image_height }}px;--spotlight-image-height-mobile: {{ product_block_st.mobile_image_height }}px;--spotlight-image-fit: {{ product_block_st.image_fit }};"
                            {% elsif card_ratio != 'inherit' %}
                              style="--spotlight-image-ratio: {% if card_ratio == 'square' %}1 / 1{% elsif card_ratio == 'portrait' %}3 / 4{% elsif card_ratio == 'landscape' %}4 / 3{% else %}16 / 9{% endif %};--spotlight-image-fit: {{ product_block_st.image_fit }};"
                            {% else %}
                              style="--spotlight-image-fit: {{ product_block_st.image_fit }};"
                            {% endif %}
                          >
                            <div class="featured-tabs-spotlight-card__inner">
                              <a class="featured-tabs-spotlight-card__media" href="{{ product_url }}">
{%- if show_card_badges and product != blank -%}
{%- render 'product-badges', card_product: product, type: 'product_item', class: badge_position -%}
{%- endif -%}
                                {%- if show_card_badges and product_badge != blank -%}
                                  <span class="featured-tabs-spotlight-card__badge">{{ product_badge }}</span>
                                {%- endif -%}
                                {%- if product_image != blank -%}
                                  {{ product_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 760, 900', sizes: '(min-width: 1025px) 25vw, 80vw', loading: 'lazy', alt: product_title }}
