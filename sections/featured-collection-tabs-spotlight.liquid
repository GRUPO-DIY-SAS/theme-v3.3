                                      <span class="featured-tabs-spotlight-card__compare">{{ product.compare_at_price | money }}</span>
                                    {%- endif -%}
                                    <span>{{ product.price | money }}</span>
                                  </div>
                                {%- endif -%}
                              </div>
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- elsif block_st.products != blank -%}
                      {%- for product in block_st.products limit: items_to_show -%}
                        {%- liquid
                          assign product_image = product.featured_image | default: collection.image
                          assign product_title = product.title | default: 'Product title'
                        -%}
                        <div class="featured-tabs-spotlight-card swiper-slide">
                          <div class="featured-tabs-spotlight-card__inner">
                            <a class="featured-tabs-spotlight-card__media" href="{{ product.url }}">
{%- if show_card_badges and product != blank -%}
{%- render 'product-badges', card_product: product, type: 'product_item', class: badge_position -%}
{%- endif -%}
                              {%- if product_image != blank -%}
                                {{ product_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 760, 900', sizes: '(min-width: 1025px) 25vw, 80vw', loading: 'lazy', alt: product_title }}
                              {%- else -%}
                                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
