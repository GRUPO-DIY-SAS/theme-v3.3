{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign heading = section_st.heading
  assign description = section_st.description
  assign eyebrow = section_st.eyebrow
  assign display_mode = section_st.display_mode
  assign product_layout = section_st.product_layout
  assign quick_layout = section_st.quick_layout
  assign card_surface = section_st.card_surface
  assign interaction_effect = section_st.interaction_effect
  # Above-the-fold priority: opt-in on the first/hero section so its media loads eagerly
  # (LCP) instead of lazy. Off everywhere else so below-fold blocks stay lazy.
  assign priority_loading = section_st.priority_loading
  assign bg_loading = 'lazy'
  assign bg_fetch = 'auto'
  assign bg_preload = false
  if priority_loading
    assign bg_loading = 'eager'
    assign bg_fetch = 'high'
    assign bg_preload = true
  endif
  assign bg_motion = section_st.bg_motion | default: 'none'
  assign geo_overlay = section_st.geo_overlay | default: 'none'
  assign motion_speed = section_st.motion_speed | default: 'balanced'
  assign background_type = section_st.background_type
  assign background_image = section_st.background_image
  assign mobile_background_image = section_st.mobile_background_image | default: background_image
  assign background_video = section_st.background_video
  assign mobile_background_video = section_st.mobile_background_video | default: background_video
  assign background_video_poster = section_st.background_video_poster | default: background_video.preview_image
  assign mobile_background_video_poster = section_st.mobile_background_video_poster | default: mobile_background_video.preview_image | default: background_video_poster
  assign background_video_source = ''
  assign mobile_background_video_source = ''
  assign items_to_show = section_st.items_to_show
  assign items_per_row = section_st.items_per_row
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign column_gap = section_st.column_gap
  assign show_arrow = section_st.show_arrow
  assign carousel_pagination = section_st.carousel_pagination
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  assign show_view_all_button = section_st.show_view_all_button
  assign show_card_title = section_st.show_card_title
  assign show_card_vendor = section_st.show_card_vendor
  assign show_card_price = section_st.show_card_price
  assign show_quick_add = section_st.show_quick_add
  assign show_quick_view = section_st.show_quick_view
  assign show_card_rating = section_st.show_card_rating
  assign show_card_compare_price = section_st.show_card_compare_price
  assign show_card_badges = section_st.show_card_badges
  # Mismas clases que product-item.liquid para que los badges del theme (Oferta %, Nuevo,
  # Agotado, Preventa, badge personalizado, marquee) se vean igual que en las product cards.
  assign badge_position = 'pointer-none absolute top-sm-15 top-10 left-sm-15 left-10 z-2'
  if settings.rtl
    assign badge_position = 'pointer-none absolute top-sm-15 top-10 right-sm-15 right-10 z-2'
  endif
  assign scroll_animation = settings.scroll_animation
  assign header_size = ''
  assign animate_delay = 0
  assign image_ratio = section_st.image_ratio
  assign reset_spacing = ''
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  if section_st.header_size == 'small'
    assign header_size = 'h3'
  elsif section_st.header_size == 'large'
    assign header_size = 'h1-size'
  endif

  if image_ratio == 'square'
    assign image_ratio_value = '1 / 1'
  elsif image_ratio == 'portrait'
    assign image_ratio_value = '3 / 4'
  elsif image_ratio == 'landscape'
    assign image_ratio_value = '4 / 3'
  elsif image_ratio == 'wide'
    assign image_ratio_value = '16 / 9'
  else
    assign image_ratio_value = 'auto'
  endif

  if items_per_row_mobile > 1 and items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif
  assign grid_mobile_columns = items_per_row_mobile | ceil

  for source in background_video.sources
    if source.format == 'mp4'
      assign background_video_source = source.url
      break
    endif
  endfor

  for source in mobile_background_video.sources
    if source.format == 'mp4'
      assign mobile_background_video_source = source.url
      break
    endif
  endfor

  assign hero_type = section_st.hero_type | default: 'none'
  assign hero_image = section_st.hero_image
  assign hero_mobile_image = section_st.hero_mobile_image | default: hero_image
  assign hero_video = section_st.hero_video
  assign hero_mobile_video = section_st.hero_mobile_video | default: hero_video
  assign hero_video_poster = section_st.hero_video_poster | default: hero_video.preview_image
  assign hero_mobile_video_poster = section_st.hero_mobile_video_poster | default: hero_mobile_video.preview_image | default: hero_video_poster

  assign hero_aspect = section_st.hero_aspect | default: 'fixed'
  case hero_aspect
    when 'square'
      assign hero_aspect_value = '1 / 1'
    when 'portrait'
      assign hero_aspect_value = '3 / 4'
    when 'landscape'
      assign hero_aspect_value = '4 / 3'
    when 'wide'
      assign hero_aspect_value = '16 / 9'
    when 'ultrawide'
      assign hero_aspect_value = '21 / 9'
    else
      assign hero_aspect_value = ''
  endcase

  assign hero_position = section_st.hero_position | default: 'center'
  case hero_position
    when 'top'
      assign hero_position_value = 'center top'
    when 'bottom'
      assign hero_position_value = 'center bottom'
    when 'left'
      assign hero_position_value = 'left center'
    when 'right'
      assign hero_position_value = 'right center'
    when 'top-left'
      assign hero_position_value = 'left top'
    when 'top-right'
      assign hero_position_value = 'right top'
    when 'bottom-left'
      assign hero_position_value = 'left bottom'
    when 'bottom-right'
      assign hero_position_value = 'right bottom'
    else
      assign hero_position_value = 'center'
  endcase

  assign hero_placement = section_st.hero_placement | default: 'top'
  assign hero_side = section_st.hero_side | default: 'left'
  assign hero_side_valign = section_st.hero_side_valign | default: 'stretch'
  assign hero_mobile_placement = section_st.hero_mobile_placement | default: 'above'
  assign hero_shown = false
  if hero_type != 'none'
    assign hero_shown = true
  endif
  assign hero_is_side = false
  if hero_shown and hero_placement == 'side'
    assign hero_is_side = true
  endif

  assign has_tab_heading = false
  assign has_tab_desc = false
  assign has_tab_eyebrow = false
  for b in section.blocks
    if b.type == 'collection'
      if b.settings.tab_heading != blank
        assign has_tab_heading = true
      endif
      if b.settings.tab_description != blank
        assign has_tab_desc = true
      endif
      if b.settings.tab_eyebrow != blank
        assign has_tab_eyebrow = true
      endif
    endif
  endfor
-%}

{%- capture section_style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- capture slider_style -%}
  {% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{ column_gap }}px;{% endif %}
{%- endcapture -%}

{%- if display_mode == 'product_tabs' and product_layout == 'carousel'
  or display_mode == 'quick_collections' and quick_layout == 'carousel'
-%}
  <script>
    (function () {
      var swiperStyle = {{ 'swiper-bundle.min.css' | asset_url | json }};
      var swiperScript = {{ 'swiper-bundle.min.js' | asset_url | json }};
      var assets = [
        { type: 'style', href: swiperStyle },
        { type: 'script', src: swiperScript }
      ];

      window.diyvapeDeferredAssets = window.diyvapeDeferredAssets || [];
      window.diyvapeDeferredAssets.push.apply(window.diyvapeDeferredAssets, assets);

      if (window.diyvapeLoadDeferredAssets) return;

      if (!document.querySelector('link[href="' + swiperStyle + '"]')) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = swiperStyle;
        link.media = 'all';
        document.head.appendChild(link);
      }

      if (!document.querySelector('script[src="' + swiperScript + '"]')) {
        var script = document.createElement('script');
        script.src = swiperScript;
        script.async = false;
        script.defer = true;
        document.head.appendChild(script);
      }
    })();
  </script>
{%- endif -%}

{%- comment -%}
  El CSS/JS estático del bloque vive en assets (una sola descarga aunque haya varias instancias);
  aquí solo quedan las variables y reglas que dependen de los ajustes de la sección.
{%- endcomment -%}
{%- if request.design_mode -%}
  {{ 'featured-collection-tabs-spotlight.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'featured-collection-tabs-spotlight.js' | asset_url }}" defer></script>
{%- else -%}
  <script>
    window.diyvapeDeferredAssets = window.diyvapeDeferredAssets || [];
    window.diyvapeDeferredAssets.push(
      { type: 'style', href: {{ 'featured-collection-tabs-spotlight.css' | asset_url | json }} },
      { type: 'script', src: {{ 'featured-collection-tabs-spotlight.js' | asset_url | json }} }
    );
  </script>
{%- endif -%}
{%- style -%}
  #shopify-section-{{ section.id }} .featured-tabs-spotlight {
    --spotlight-bg: {{ section_st.background_color }};
    --spotlight-shape: {{ section_st.shape_color }};
    --spotlight-shape-opacity: {{ section_st.shape_opacity | divided_by: 100.0 }};
    --spotlight-shape-rot: {{ section_st.shape_rotation | default: 0 }}deg;
    --spotlight-shape-scale: {{ section_st.shape_scale | default: 100 | divided_by: 100.0 }};
    --spotlight-shape-ox: {{ section_st.shape_offset_x | default: 0 }}px;
    --spotlight-shape-oy: {{ section_st.shape_offset_y | default: 0 }}px;
    --spotlight-motion-1: {{ section_st.motion_accent_1 | default: '#7c5cff' }};
    --spotlight-motion-2: {{ section_st.motion_accent_2 | default: '#2dd4bf' }};
    --spotlight-motion-opacity: {{ section_st.motion_opacity | default: 55 | divided_by: 100.0 }};
    --spotlight-motion-amp: {{ section_st.motion_intensity | default: 100 | divided_by: 100.0 }};
    --spotlight-motion-blend: {{ section_st.motion_blend | default: 'normal' }};
    --spotlight-grain-opacity: {{ section_st.grain_opacity | default: 8 | divided_by: 100.0 }};
    --spotlight-motion-phase: {{ section_st.motion_phase | default: 0 }};
    --spotlight-motion-phase-delay: calc({{ section_st.motion_phase | default: 0 }} * -7s);
    --spotlight-blend-overlap: {{ section_st.blend_overlap | default: 0 }}px;
    --spotlight-tab-bg: {{ section_st.tab_background }};
    --spotlight-tab-text: {{ section_st.tab_text_color }};
    --spotlight-tab-active-bg: {{ section_st.tab_active_background }};
    --spotlight-tab-active-text: {{ section_st.tab_active_text_color }};
    --spotlight-card-bg: {{ section_st.card_background }};
    --spotlight-card-text: {{ section_st.card_text_color }};
    --spotlight-card-title-lines: {{ section_st.card_title_lines | default: 2 }};
    --spotlight-header-max: {% if section_st.header_max_width > 0 %}{{ section_st.header_max_width }}px{% else %}none{% endif %};
    --spotlight-overlay: {{ section_st.background_overlay_color }};
    --spotlight-overlay-opacity: {{ section_st.background_overlay_opacity | divided_by: 100.0 }};
    --spotlight-image-ratio: {{ image_ratio_value }};
    --spotlight-image-height: {{ section_st.image_height }}px;
    --spotlight-image-height-mobile: {{ section_st.mobile_image_height }}px;
    --spotlight-image-fit: {{ section_st.image_fit }};
    --spotlight-product-cols: {{ items_per_row }};
    --spotlight-product-mobile-cols: {{ grid_mobile_columns }};
    --spotlight-quick-cols: {{ section_st.quick_columns }};
    --spotlight-quick-mobile-cols: {{ section_st.quick_mobile_columns }};
    --spotlight-media-inset-y: {{ section_st.media_padding_y }}px;
    --spotlight-media-inset-x: {{ section_st.media_padding_x }}px;
    --spotlight-media-radius: {{ section_st.media_radius }}px;
    --spotlight-media-height: {{ section_st.media_height }}px;
    --spotlight-media-height-mobile: {{ section_st.mobile_media_height }}px;
    --spotlight-hero-height: {{ section_st.hero_height | default: 360 }}px;
    --spotlight-hero-height-mobile: {{ section_st.hero_mobile_height | default: 220 }}px;
    --spotlight-hero-radius: {{ section_st.hero_radius | default: 0 }}px;
    --spotlight-hero-overlay: {{ section_st.hero_overlay_color | default: '#000000' }};
    --spotlight-hero-overlay-opacity: {{ section_st.hero_overlay_opacity | default: 0 | divided_by: 100.0 }};
    --spotlight-hero-position: {{ hero_position_value }};
    --spotlight-hero-side-width: {{ section_st.hero_side_width | default: 42 }}%;
    {%- if hero_aspect_value != blank -%}--spotlight-hero-aspect: {{ hero_aspect_value }};{%- endif -%}
    --spotlight-image-radius: {{ section_st.image_radius }}px;
    --spotlight-badge-bg: {{ section_st.badge_background }};
    --spotlight-badge-text: {{ section_st.badge_text_color }};
    position: relative;
    overflow: hidden;
    background: var(--spotlight-bg);
  }

  #shopify-section-{{ section.id }} .featured-tabs-spotlight--glass-refraction.featured-tabs-spotlight--layout-grid .featured-tabs-spotlight-card__inner,
  #shopify-section-{{ section.id }} .featured-tabs-spotlight--glass-refraction.featured-tabs-spotlight--layout-hero_cards .featured-tabs-spotlight-card__inner {
    -webkit-backdrop-filter: blur(20px) saturate(190%) brightness(1.1);
    backdrop-filter: blur(7px) saturate(190%) brightness(1.1) url("#spotlight-glass-{{ section.id }}");
  }

  {%- if section_st.text_size_heading > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight__header .section__header-heading { font-size: {{ section_st.text_size_heading }}px; }
  {%- endif -%}
  {%- if section_st.text_size_description > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight__header .section__header-des { font-size: {{ section_st.text_size_description }}px; }
  {%- endif -%}
  {%- if section_st.text_size_tab > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight__tab { font-size: {{ section_st.text_size_tab }}px; }
  {%- endif -%}
  {%- if section_st.text_size_card_title > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__title { font-size: {{ section_st.text_size_card_title }}px; }
  {%- endif -%}
  {%- if section_st.text_size_card_meta > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__vendor,
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__eyebrow { font-size: {{ section_st.text_size_card_meta }}px; }
  {%- endif -%}
  {%- if section_st.text_size_card_price > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-card__price { font-size: {{ section_st.text_size_card_price }}px; }
  {%- endif -%}
  {%- if section_st.text_size_quick_title > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__title { font-size: {{ section_st.text_size_quick_title }}px; }
  {%- endif -%}
  {%- if section_st.text_size_quick_subtitle > 0 -%}
    #shopify-section-{{ section.id }} .featured-tabs-spotlight-quick__subtitle { font-size: {{ section_st.text_size_quick_subtitle }}px; }
  {%- endif -%}
{%- endstyle -%}

<div
  class="section featured-tabs-spotlight featured-tabs-spotlight--shape-{{ section_st.shape_style }} featured-tabs-spotlight--bg-{{ background_type }} featured-tabs-spotlight--mode-{{ display_mode }} featured-tabs-spotlight--layout-{{ product_layout }} featured-tabs-spotlight--quick-layout-{{ quick_layout }} featured-tabs-spotlight--cards-{{ card_surface }} featured-tabs-spotlight--fx-{{ interaction_effect }}{% if image_ratio == 'fixed' %} featured-tabs-spotlight--ratio-fixed{% endif %} color-{{ color_scheme }} gradient{% if section_st.animate_shape %} featured-tabs-spotlight--shape-motion{% endif %}{% if section_st.shape_anchor != blank and section_st.shape_anchor != 'auto' %} featured-tabs-spotlight--shape-anchor-{{ section_st.shape_anchor }}{% endif %}{% if section_st.blend_edge == 'top' or section_st.blend_edge == 'both' %} featured-tabs-spotlight--blend-top{% endif %}{% if section_st.blend_edge == 'bottom' or section_st.blend_edge == 'both' %} featured-tabs-spotlight--blend-bottom{% endif %}{% if bg_motion != 'none' %} featured-tabs-spotlight--motion-{{ bg_motion }} featured-tabs-spotlight--motion-speed-{{ motion_speed }}{% endif %}{% if section_st.geo_parallax and geo_overlay != 'none' %} featured-tabs-spotlight--geo-parallax{% endif %}{% if section_st.glass_refraction and card_surface == 'glass' %} featured-tabs-spotlight--glass-refraction{% endif %}{% if hero_aspect_value != blank %} featured-tabs-spotlight--hero-aspect{% endif %}{% if hero_shown %} featured-tabs-spotlight--hero-mobile-{{ hero_mobile_placement }}{% endif %}{% if hero_is_side %} featured-tabs-spotlight--hero-side featured-tabs-spotlight--hero-side-{{ hero_side }} featured-tabs-spotlight--hero-valign-{{ hero_side_valign }}{% endif %}{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %}{{ reset_spacing }}"
  style="{{ section_style | strip | strip_newlines }}"
>
  {%- comment %} Above-the-fold LCP hint. Image/parallax heroes preload via the image_tag
     preload argument below; a video background has no image_tag, so its poster (the LCP for
     that case) is preloaded with a link here. {% endcomment -%}
  {%- if priority_loading and background_type == 'video' and background_video_poster != blank -%}
    {% # theme-check-disable AssetPreload %}
    <link rel="preload" as="image" href="{{ background_video_poster | image_url: width: 1800 }}" fetchpriority="high">
    {% # theme-check-enable AssetPreload %}
  {%- endif -%}
  {%- if background_type == 'image' or background_type == 'parallax' -%}
    <div
      class="featured-tabs-spotlight__background"
      {% if background_type == 'parallax' and background_image != blank %}
        style="--spotlight-bg-desktop: url('{{ background_image | image_url: width: 2400 }}'); --spotlight-bg-mobile: url('{{ mobile_background_image | image_url: width: 1200 }}');"
      {% endif %}
    >
      {%- if background_image != blank -%}
        {{ background_image | image_url: width: 2400 | image_tag: class: 'featured-tabs-spotlight__background-desktop', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: bg_loading, fetchpriority: bg_fetch, preload: bg_preload, alt: heading }}
      {%- endif -%}
      {%- if mobile_background_image != blank -%}
        {{ mobile_background_image | image_url: width: 1200 | image_tag: class: 'featured-tabs-spotlight__background-mobile', widths: '375, 550, 750, 950, 1200', sizes: '100vw', loading: bg_loading, fetchpriority: bg_fetch, alt: heading }}
      {%- endif -%}
    </div>
  {%- elsif background_type == 'video' -%}
    <div class="featured-tabs-spotlight__background">
      {%- if background_video_source != blank -%}
        <video
          class="featured-tabs-spotlight__background-desktop lazy-video"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          data-video-load="interaction"
          data-no-idle="true"
          data-src="{{ background_video_source }}"
          {% if background_video_poster != blank %}
            data-poster="{{ background_video_poster | image_url: width: 1800 }}"
            poster="{{ background_video_poster | image_url: width: 1800 }}"
          {% endif %}
        ></video>
      {%- endif -%}
      {%- if mobile_background_video_source != blank -%}
        <video
          class="featured-tabs-spotlight__background-mobile lazy-video"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          data-video-load="interaction"
          data-no-idle="true"
          data-src="{{ mobile_background_video_source }}"
          {% if mobile_background_video_poster != blank %}
            data-poster="{{ mobile_background_video_poster | image_url: width: 900 }}"
            poster="{{ mobile_background_video_poster | image_url: width: 900 }}"
          {% endif %}
        ></video>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="featured-tabs-spotlight__shape"></div>
  {%- if bg_motion != 'none' -%}
    <div class="featured-tabs-spotlight__motion" aria-hidden="true">
      {%- case bg_motion -%}
        {%- when 'floating' -%}
          {%- render 'spotlight-geo-shapes', kind: 'floating' -%}
        {%- when 'aurora' -%}
          <span class="spotlight-motion__orb" style="--x:-8%;--y:-12%;--s:48vw;--c:var(--spotlight-motion-1);--dx:7vw;--dy:6vw;--sc:1.25;--k:1.3;--delay:0s"></span>
          <span class="spotlight-motion__orb" style="--x:60%;--y:20%;--s:42vw;--c:var(--spotlight-motion-2);--dx:-6vw;--dy:7vw;--sc:1.18;--k:1.5;--delay:1.5s"></span>
          <span class="spotlight-motion__orb" style="--x:30%;--y:60%;--s:38vw;--c:color-mix(in srgb, var(--spotlight-motion-1), var(--spotlight-motion-2));--dx:5vw;--dy:-6vw;--sc:1.3;--k:1.15;--delay:3s"></span>
        {%- when 'grid' -%}
          <span class="spotlight-motion__grid"></span>
        {%- when 'mesh' -%}
          <span class="spotlight-motion__mesh"></span>
        {%- when 'beams' -%}
          <span class="spotlight-motion__beams"></span>
        {%- when 'particles' -%}
          {%- render 'spotlight-geo-shapes', kind: 'particles' -%}
      {%- endcase -%}
    </div>
  {%- endif -%}
  {%- if geo_overlay != 'none' -%}
    <div class="featured-tabs-spotlight__motion featured-tabs-spotlight__motion--geo" aria-hidden="true">
      {%- render 'spotlight-geo-shapes', kind: geo_overlay -%}
    </div>
  {%- endif -%}
  {%- if section_st.bg_grain -%}
    <div class="featured-tabs-spotlight__grain" aria-hidden="true"></div>
  {%- endif -%}
  {%- capture hero_markup -%}
    {%- if hero_shown -%}
      <div class="featured-tabs-spotlight__hero">
        {%- render 'spotlight-hero-media',
          media_type: hero_type,
          image: hero_image,
          mobile_image: hero_mobile_image,
          video: hero_video,
          mobile_video: hero_mobile_video,
          video_poster: hero_video_poster,
          mobile_video_poster: hero_mobile_video_poster,
          block_key: '__default__',
          alt: heading
        -%}
        {%- if display_mode == 'product_tabs' -%}
          {%- for b in section.blocks -%}
            {%- if b.type == 'collection' and b.settings.tab_hero_type != blank and b.settings.tab_hero_type != 'inherit' and b.settings.tab_hero_type != 'none' -%}
              {%- render 'spotlight-hero-media',
                media_type: b.settings.tab_hero_type,
                image: b.settings.tab_hero_image,
                mobile_image: b.settings.tab_hero_mobile_image,
                video: b.settings.tab_hero_video,
                mobile_video: b.settings.tab_hero_mobile_video,
                video_poster: b.settings.tab_hero_video_poster,
                mobile_video_poster: b.settings.tab_hero_mobile_video_poster,
                block_key: b.id,
                alt: b.settings.collection_title
              -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endcapture -%}
  <div class="{{ section_width }} featured-tabs-spotlight__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'rich_text' and block.settings.position == 'top' -%}
        {%- render 'spotlight-rich-text', block: block -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if hero_shown and hero_placement != 'side' -%}{{ hero_markup }}{%- endif -%}
    {%- if display_mode == 'product_tabs' -%}
      <tab-items data-type="horizontal">
    {%- endif -%}
      {%- if heading != blank or description != blank or eyebrow != blank or section_st.hero_cta_label != blank or has_tab_heading or has_tab_desc or has_tab_eyebrow -%}
        <div class="featured-tabs-spotlight__header section__header text-{{ section_st.header_alignment }}">
          {%- if display_mode == 'product_tabs' -%}
            {%- comment %} One crawlable h2/h3 variant per tab; the active one is shown, the rest hidden. {% endcomment -%}
            {%- assign hv_index = 0 -%}
            {%- for b in section.blocks -%}
              {%- if b.type == 'collection' -%}
                {%- assign hv_index = hv_index | plus: 1 -%}
                {%- assign hv_eyebrow = b.settings.tab_eyebrow | default: eyebrow -%}
                {%- assign hv_heading = b.settings.tab_heading | default: heading -%}
                {%- assign hv_desc = b.settings.tab_description | default: description -%}
                <div class="featured-tabs-spotlight__header-variant" data-header-block="{{ b.id }}"{% unless hv_index == 1 %} hidden{% endunless %}>
                  {%- if hv_eyebrow != blank -%}
                    <span class="featured-tabs-spotlight__eyebrow">{{ hv_eyebrow }}</span>
                  {%- endif -%}
                  {%- if hv_heading != blank -%}
                    <h2 class="section__header-heading heading-letter-spacing {{ header_size }} mt-0{% if hv_desc != blank %} mb-10{% else %} mb-0{% endif %}">{{ hv_heading }}</h2>
                  {%- endif -%}
                  {%- if hv_desc != blank -%}
                    <div class="section__header-des rich__text-m0">{{ hv_desc }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- if eyebrow != blank -%}
              <span class="featured-tabs-spotlight__eyebrow block">{{ eyebrow }}</span>
            {%- endif -%}
            {%- if heading != blank -%}
              <motion-element
                data-motion="{{ scroll_animation }}"
                data-motion-delay="{{ animate_delay }}"
                {% if scroll_animation == 'none' %}hold{% endif %}
                class="block"
              >
                <h2 class="section__header-heading heading-letter-spacing {{ header_size }} mt-0{% if description != blank %} mb-10{% else %} mb-0{% endif %}">
                  {{ heading }}
                </h2>
              </motion-element>
            {%- endif -%}
            {%- if description != blank -%}
              {%- assign animate_delay = animate_delay | plus: 50 -%}
              <motion-element
                data-motion="{{ scroll_animation }}"
                data-motion-delay="{{ animate_delay }}"
                {% if scroll_animation == 'none' %}hold{% endif %}
                class="section__header-des rich__text-m0 block"
              >
                {{ description }}
              </motion-element>
            {%- endif -%}
          {%- endif -%}
          {%- if section_st.hero_cta_label != blank -%}
            <div class="featured-tabs-spotlight__hero-cta">
              <a class="btn-primary no-underline inline-flex" href="{{ section_st.hero_cta_link | default: '#' }}">{{ section_st.hero_cta_label }}</a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if display_mode == 'quick_collections' -%}
        {%- if hero_is_side -%}<div class="featured-tabs-spotlight__split">{{ hero_markup }}{%- endif -%}
        {%- if quick_layout == 'carousel' -%}
          <slide-section
            class="featured-tabs-spotlight-quick swiper"
            data-section-id="{{ section.id }}"
            data-autoplay="{{ autoplay }}"
            data-effect="slide"
            data-loop="{{ infinite }}"
            data-speed="800"
            data-autoplay-speed="{{ autorotate_speed }}"
            data-spacing="{{ column_gap }}"
            data-mobile="{{ section_st.quick_mobile_columns }}"
            data-tablet="3"
            data-desktop="{{ section_st.quick_columns }}"
            data-free-scroll="true"
            data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
            data-arrow-centerimage="1"
            style="{{ slider_style | strip | strip_newlines }}"
          >
            {%- if show_arrow -%}
              {%- render 'swiper-navigation' -%}
            {%- endif -%}
            <div class="swiper-wrapper">
        {%- else -%}
          <div class="featured-tabs-spotlight-quick" style="{{ slider_style | strip | strip_newlines }}">
        {%- endif -%}
          {%- assign quick_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'quick_collection' -%}
              {%- liquid
                assign quick_count = quick_count | plus: 1
                assign block_st = block.settings
                assign collection = block_st.collection
                assign quick_title = block_st.title | default: collection.title | default: 'Collection'
                assign quick_subtitle = block_st.subtitle
                assign quick_eyebrow = block_st.eyebrow
                assign quick_description = block_st.description
                assign quick_image = block_st.custom_image | default: collection.image
                assign quick_link = block_st.custom_link | default: collection.url | default: '#'
                assign quick_ratio = block_st.image_ratio
                assign quick_btn1_label = block_st.button_label
                assign quick_btn1_link = block_st.button_link | default: quick_link
                assign quick_btn2_label = block_st.button_label_2
                assign quick_btn2_link = block_st.button_link_2 | default: quick_link
                assign q_loading = 'lazy'
                assign q_fetch = 'auto'
                if priority_loading and quick_count <= 4
                  assign q_loading = 'eager'
                  assign q_fetch = 'high'
                endif
              -%}
              <div
                class="featured-tabs-spotlight-quick__item text-{{ block_st.text_alignment }}{% if quick_layout == 'carousel' %} swiper-slide{% endif %}{% if quick_ratio == 'fixed' %} featured-tabs-spotlight-quick__item--fixed{% endif %}"
                {{ block.shopify_attributes }}
                {% if quick_ratio == 'fixed' %}
                  style="--spotlight-image-height: {{ block_st.image_height }}px;--spotlight-image-height-mobile: {{ block_st.mobile_image_height }}px;--spotlight-image-fit: {{ block_st.image_fit }};"
                {% elsif quick_ratio != 'inherit' %}
                  style="--spotlight-image-ratio: {% if quick_ratio == 'square' %}1 / 1{% elsif quick_ratio == 'portrait' %}3 / 4{% elsif quick_ratio == 'landscape' %}4 / 3{% else %}16 / 9{% endif %};--spotlight-image-fit: {{ block_st.image_fit }};"
                {% else %}
                  style="--spotlight-image-fit: {{ block_st.image_fit }};"
                {% endif %}
              >
                <a class="featured-tabs-spotlight-quick__media" href="{{ quick_link }}" aria-label="{{ quick_title | escape }}">
                  {%- if quick_image != blank -%}
                    {{ quick_image | image_url: width: 900 | image_tag: widths: '240, 360, 480, 640, 760, 900', sizes: '(min-width: 1025px) 25vw, 80vw', loading: q_loading, fetchpriority: q_fetch, alt: quick_title }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                <div class="featured-tabs-spotlight-quick__body{% if block_st.text_surface != 'none' %} featured-tabs-spotlight-quick__body--surface featured-tabs-spotlight-quick__body--{{ block_st.text_surface }}{% endif %}">
                  {%- if quick_eyebrow != blank -%}
                    <span class="featured-tabs-spotlight-quick__eyebrow block">{{ quick_eyebrow }}</span>
                  {%- endif -%}
                  <a class="featured-tabs-spotlight-quick__title-link block" href="{{ quick_link }}">
                    <h3 class="featured-tabs-spotlight-quick__title h4 block">{{ quick_title }}</h3>
                  </a>
                  {%- if quick_subtitle != blank -%}
                    <span class="featured-tabs-spotlight-quick__subtitle block">{{ quick_subtitle }}</span>
                  {%- endif -%}
                  {%- if quick_description != blank -%}
                    <div class="featured-tabs-spotlight-quick__text rich__text-m0">{{ quick_description }}</div>
                  {%- endif -%}
                  {%- if quick_btn1_label != blank or quick_btn2_label != blank -%}
                    <div class="featured-tabs-spotlight-quick__buttons">
                      {%- if quick_btn1_label != blank -%}
                        <a class="btn-primary no-underline inline-flex" href="{{ quick_btn1_link }}">{{ quick_btn1_label }}</a>
                      {%- endif -%}
                      {%- if quick_btn2_label != blank -%}
                        <a class="btn-outline no-underline inline-flex" href="{{ quick_btn2_link }}">{{ quick_btn2_label }}</a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if quick_count == 0 -%}
            {%- for i in (1..4) -%}
              <a class="featured-tabs-spotlight-quick__item{% if quick_layout == 'carousel' %} swiper-slide{% endif %}" href="#">
                <span class="featured-tabs-spotlight-quick__media">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </span>
                <span class="featured-tabs-spotlight-quick__body">
                  <h3 class="featured-tabs-spotlight-quick__title h4 block">{{ 'onboarding.collection_title' | t }}</h3>
                </span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- if quick_layout == 'carousel' -%}
            </div>
            {%- if carousel_pagination == 'show_dots'
              or carousel_pagination == 'show_dots_on_mobile'
              or carousel_pagination == 'show_progress_bar'
            -%}
              <div
                class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center"
                style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
              ></div>
            {%- endif -%}
          </slide-section>
        {%- else -%}
          </div>
        {%- endif -%}
        {%- if hero_is_side -%}</div>{%- endif -%}
      {%- else -%}
      {%- assign tab_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' -%}
          {%- assign tab_index = tab_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if tab_index > 0 -%}
