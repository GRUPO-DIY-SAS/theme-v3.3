                  data-speed="800"
                  data-autoplay-speed="{{ autorotate_speed }}"
                  data-spacing="{{ column_gap }}"
                  data-mobile="{{ items_per_row_mobile }}"
                  data-tablet="3"
                  data-desktop="{{ items_per_row }}"
                  data-free-scroll="{{ data_free_scroll }}"
                  data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
                  data-arrow-centerimage="1"
                >
                  {%- if product_layout == 'carousel' and show_arrow -%}
                    {%- render 'swiper-navigation' -%}
                  {%- endif -%}
                  <div
                    class="{% if product_layout == 'carousel' %}swiper-wrapper{% else %}featured-tabs-spotlight-products featured-tabs-spotlight-products--{{ product_layout }}{% endif %}"
                    style="{{ slider_style | strip | strip_newlines }}"
                  >
                    {%- if custom_product_count > 0 -%}
                      {%- assign rendered_custom_products = 0 -%}
                      {%- for product_block in section.blocks -%}
                        {%- if product_block.type == 'custom_product' and product_block.settings.tab_key == tab_key and rendered_custom_products < items_to_show -%}
                          {%- liquid
                            assign product_block_st = product_block.settings
                            assign product = product_block_st.product
                            assign product_image = product_block_st.custom_image | default: product.featured_image | default: collection.image
                            assign product_title = product_block_st.title | default: product.title | default: 'Product title'
                            assign product_url = product.url | default: product_block_st.custom_link | default: '#'
                            assign product_eyebrow = product_block_st.eyebrow | default: product.vendor
                            assign product_badge = product_block_st.badge_text
                            assign card_ratio = product_block_st.image_ratio
                            assign rendered_custom_products = rendered_custom_products | plus: 1
                          -%}
                          <div
                            class="featured-tabs-spotlight-card swiper-slide{% if card_ratio == 'fixed' %} featured-tabs-spotlight-card--fixed{% endif %}"
