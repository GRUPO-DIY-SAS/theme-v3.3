                {%- endif -%}
              {%- endfor -%}
              <div
                class="collection-tab__tab-content{% if tab_content_index == 1 %} active{% else %} hidden{% endif %}"
                data-block-id="{{ block.id }}"
                id="spotlight-panel-{{ block.id }}"
                role="tabpanel"
                aria-labelledby="spotlight-tab-{{ block.id }}"
                tabindex="0"
                data-collection-url="{{ tab_cta_link }}"
              >
                <slide-section
                  class="{% if product_layout == 'carousel' %}swiper{% else %}featured-tabs-spotlight__products-shell{% endif %}"
