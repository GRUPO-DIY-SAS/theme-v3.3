                      {%- for i in (1..items_to_show) -%}
                        <div class="featured-tabs-spotlight-card swiper-slide">
                          <div class="featured-tabs-spotlight-card__inner">
                            <div class="featured-tabs-spotlight-card__media">
                              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
