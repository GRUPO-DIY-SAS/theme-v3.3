                      <div
                        class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center"
                        style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;z-index: 2"
                      ></div>
                    {%- endif -%}
                  {%- endif -%}
                </slide-section>
                  {%- comment %} In side-hero layout the CTA renders below the split (see after
                     the split close) so the hero centers against the cards, not the CTA. {% endcomment -%}
                  {%- if tab_cta_label != blank and hero_is_side != true -%}
                    <div class="featured-tabs-spotlight__tab-cta text-center">
                      <a class="btn-primary no-underline inline-flex" href="{{ tab_cta_link }}">
                        {{ tab_cta_label }}
                      </a>
                    </div>
                  {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if hero_is_side -%}</div>{%- endif -%}

        {%- comment %} Side-hero CTA row: rendered outside __split (full width below) so it's not
           part of the hero's vertical centering. Same data-block-id + .collection-tab__tab-content
           class means TabItems toggles it in sync with the active tab. {% endcomment -%}
        {%- if hero_is_side -%}
          {%- assign cta_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' -%}
              {%- liquid
                assign cta_idx = cta_idx | plus: 1
                assign cta_block_st = block.settings
                assign cta_label = cta_block_st.cta_label
                assign cta_link = cta_block_st.cta_link | default: cta_block_st.collection.url | default: '#'
              -%}
              {%- if cta_label != blank -%}
                <div class="collection-tab__tab-content featured-tabs-spotlight__cta-row{% if cta_idx == 1 %} active{% else %} hidden{% endif %}" data-block-id="{{ block.id }}">
                  <div class="featured-tabs-spotlight__tab-cta text-center">
                    <a class="btn-primary no-underline inline-flex" href="{{ cta_link }}">{{ cta_label }}</a>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if show_view_all_button -%}
          <div class="featured-tabs-spotlight__view-all text-center">
            <a class="btn_view-all no-underline inline-flex btn-primary" data-role="view-all" href="#">
              {{ 'general.view_all' | t }}
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
      {%- endif -%}
    {%- if display_mode == 'product_tabs' -%}
      </tab-items>
      <spotlight-tab-sync></spotlight-tab-sync>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'rich_text' and block.settings.position == 'bottom' -%}
        {%- render 'spotlight-rich-text', block: block -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section_st.glass_refraction and card_surface == 'glass' -%}
    {%- comment %} SVG displacement that the glass backdrop-filter bends light through (Chrome/Edge). {% endcomment -%}
    <svg class="featured-tabs-spotlight__glass-svg" aria-hidden="true" focusable="false" width="0" height="0">
      <filter id="spotlight-glass-{{ section.id }}" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.013" numOctaves="2" seed="11" result="t" />
        <feGaussianBlur in="t" stdDeviation="2.4" result="b" />
        <feDisplacementMap in="SourceGraphic" in2="b" scale="36" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
  {%- endif -%}

</div>



