                data-block-id="{{ block.id }}"
                data-style="spotlight"
                id="spotlight-tab-{{ block.id }}"
                role="tab"
                aria-controls="spotlight-panel-{{ block.id }}"
                aria-selected="{% if tab_button_index == 1 %}true{% else %}false{% endif %}"
                tabindex="{% if tab_button_index == 1 %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if collection_title != blank -%}
                  {{ collection_title }}
                {%- else -%}
                  {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
          <span class="featured-tabs-spotlight__tab-indicator" aria-hidden="true"></span>
        </div>

        {%- if hero_is_side -%}<div class="featured-tabs-spotlight__split">{{ hero_markup }}{%- endif -%}
        <div class="featured-tabs-spotlight__content tab-content">
